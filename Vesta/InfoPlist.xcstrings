{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "comment": "Purpose shown by iOS when Vesta asks for the camera to scan a receipt.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم Vesta الكاميرا لمسح الإيصال ضوئيًا. يُقرأ النص على iPhone الخاص بك؛ لا يتم حفظ الصورة أو رفعها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta রসিদ স্ক্যান করতে ক্যামেরা ব্যবহার করে। আপনার iPhone-এ টেক্সট পড়া হয়; ছবিটি সংরক্ষণ বা আপলোড করা হয় না।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta koristi kameru za skeniranje računa. Tekst se čita na tvom iPhoneu; fotografija se ne sprema niti učitava."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta používá fotoaparát ke skenování účtenky. Text se čte na tvém iPhonu; fotka se neukládá ani nenahrává."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta bruger kameraet til at scanne en kvittering. Teksten læses på din iPhone; fotoet hverken gemmes eller uploades."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta verwendet die Kamera zum Scannen eines Kassenbons. Der Text wird auf deinem iPhone gelesen; das Foto wird weder gespeichert noch hochgeladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Vesta χρησιμοποιεί την κάμερα για σάρωση απόδειξης. Το κείμενο διαβάζεται στο iPhone σου· η φωτογραφία δεν αποθηκεύεται ούτε μεταφορτώνεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta uses the camera to scan a receipt. The text is read on your iPhone; the photo is not saved or uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta usa la cámara para escanear un recibo. El texto se lee en tu iPhone; la foto no se guarda ni se sube."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta از دوربین برای اسکن رسید استفاده می‌کند. متن روی iPhone تو خوانده می‌شود؛ عکس ذخیره یا بارگذاری نمی‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta käyttää kameraa kuitin skannaamiseen. Teksti luetaan iPhonellasi; kuvaa ei tallenneta eikä lähetetä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginagamit ng Vesta ang camera para mag-scan ng resibo. Binabasa ang text sa iyong iPhone; hindi sine-save o ina-upload ang larawan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta utilise l’appareil photo pour scanner un reçu. Le texte est lu sur ton iPhone ; la photo n’est ni enregistrée ni téléversée."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Úsáideann Vesta an ceamara chun admháil a scanadh. Léitear an téacs ar do iPhone; ní shábháiltear agus ní uaslódáiltear an grianghraf."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta משתמשת במצלמה כדי לסרוק קבלה. הטקסט נקרא ב-iPhone שלך; התמונה לא נשמרת ולא מועלית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta रसीद स्कैन करने के लिए कैमरे का उपयोग करता है। टेक्स्ट आपके iPhone पर पढ़ा जाता है; फ़ोटो न सहेजी जाती है और न अपलोड की जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta koristi kameru za skeniranje računa. Tekst se čita na tvom iPhoneu; fotografija se ne sprema niti učitava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vesta a kamerát blokk beolvasására használja. A szöveg az iPhoneodon kerül beolvasásra; a fotó nem kerül mentésre vagy feltöltésre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta-ն օգտագործում է տեսախցիկը անդորրագիր սկանավորելու համար։ Տեքստը կարդացվում է քո iPhone-ում; լուսանկարը չի պահպանվում և չի վերբեռնվում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta menggunakan kamera untuk memindai struk. Teks dibaca di iPhone kamu; foto tidak disimpan atau diunggah."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta notar myndavélina til að skanna kvittun. Textinn er lesinn á iPhone-inum þínum; myndin er hvorki vistuð né hlaðið upp."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta usa la fotocamera per scansionare uno scontrino. Il testo viene letto sul tuo iPhone; la foto non viene salvata né caricata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vestaはレシートのスキャンにカメラを使用します。テキストの読み取りはiPhone上で行われ、写真が保存・アップロードされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta가 영수증을 스캔하기 위해 침라를 사용합니다. 텍스트는 iPhone에서 읽히며 사진은 저장되거나 업로드되지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta naudoja kamerą kvitui nuskaityti. Tekstas nuskaitomas jūsų iPhone; nuotrauka neišsaugoma ir neįkeliama."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta izmanto kameru, lai skenētu kvīti. Teksts tiek nolasīts jūsu iPhone; fotoattēls netiek ne saglabāts, ne augšupielādēts."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta menggunakan kamera untuk mengimbas resit. Teks dibaca pada iPhone anda; foto tidak disimpan atau dimuat naik."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta သည် ပြေစာစကင်ဖတ်ရန် ကင်မရာကိုအသုံးပြုသည်။ စာသားကို သင့် iPhone တွင် ဖတ်သည်; ဓာတ်ပုံကို သိမ်းဆည်းခြင်း သို့မဟုတ် အပ်လုဒ်လုပ်ခြင်း မပြုပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta bruker kameraet til å skanne en kvittering. Teksten leses på iPhonen din; bildet verken lagres eller lastes opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta gebruikt de camera om een bon te scannen. De tekst wordt op je iPhone gelezen; de foto wordt niet bewaard of geüpload."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta używa aparatu do skanowania paragonów. Tekst jest odczytywany na Twoim iPhonie; zdjęcie nie jest zapisywane ani wysyłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vesta usa a câmera para escanear um recibo. O texto é lido no seu iPhone; a foto não é salva nem enviada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta folosește camera pentru a scana un bon. Textul este citit pe iPhone-ul tău; fotografia nu este nici salvată, nici încărcată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta использует камеру для сканирования чека. Текст распознаётся на вашем iPhone; фото не сохраняется и не загружается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta používa fotoaparát na skenovanie účtenky. Text sa číta v tvojom iPhone; fotka sa neukladá ani nenahráva."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta përdor kamerën për të skanuar një faturë. Teksti lexohet në iPhone-in tënd; fotoja nuk ruhet dhe nuk ngarkohet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta koristi kameru za skeniranje računa. Tekst se čita na tvom iPhone-u; fotografija se ne čuva niti otprema."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta använder kameran för att skanna ett kvitto. Texten läses på din iPhone; fotot varken sparas eller laddas upp."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta hutumia kamera kuskeni risiti. Maandishi husomwa kwenye iPhone yako; picha haihifadhiwi wala kupakiwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta ใช้กล้องเพื่อสแกนใบเสร็จ ข้อความจะถูกอ่านบน iPhone ของคุณ รูปภาพจะไม่ถูกบันทึกหรืออัปโหลด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta, fiş taramak için kamerayı kullanır. Metin iPhone’unuzda okunur; fotoğraf ne kaydedilir ne de yüklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta використовує камеру для сканування чека. Текст зчитується на вашому iPhone; фото не зберігається й не завантажується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta dùng camera để quét hóa đơn. Văn bản được đọc trên iPhone của bạn; ảnh không được lưu hoặc tải lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta 使用相机扫描小票。文本在你的 iPhone 上读取；照片不会存储或上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta 使用相機掃描收據。文字會在你的 iPhone 上讀取；照片不會儲存或上傳。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "Purpose shown by iOS when Vesta requests access to the local network to connect to the user's own hestia server.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتصل Vesta بخادم hestia الذي تُدخل عنوانه. يتطلب الاتصال به على شبكتك المنزلية الوصول إلى الشبكة المحلية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta আপনার দেওয়া ঠিকানার hestia সার্ভারে সংযোগ করে। আপনার বাড়ির নেটওয়ার্কে সংযোগ করতে স্থানীয় নেটওয়ার্কে প্রবেশের অনুমতি প্রয়োজন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta se povezuje s hestia serverom čiju adresu unesete. Povezivanje na vašoj kućnoj mreži zahtijeva pristup lokalnoj mreži."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta se připojuje k serveru hestia na zadané adrese. Připojení ve vaší domácí síti vyžaduje přístup k místní síti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta opretter forbindelse til hestia-serveren på den adresse, du angiver. På dit hjemmenetværk kræver det adgang til det lokale netværk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta verbindet sich mit dem hestia-Server unter der von Ihnen eingegebenen Adresse. In Ihrem Heimnetzwerk ist dafür Zugriff auf das lokale Netzwerk erforderlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Vesta συνδέεται στον διακομιστή hestia στη διεύθυνση που εισάγετε. Η σύνδεση μέσω του οικιακού σας δικτύου απαιτεί πρόσβαση στο τοπικό δίκτυο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta connects to the hestia server you enter — on your home network this requires local network access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta se conecta al servidor hestia cuya dirección introduces. En tu red doméstica, esto requiere acceso a la red local."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta به سرور hestia با نشانی‌ای که وارد می‌کنید متصل می‌شود. اتصال در شبکهٔ خانگی شما به دسترسی به شبکهٔ محلی نیاز دارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta muodostaa yhteyden hestia-palvelimeen antamassasi osoitteessa. Kotiverkossasi tämä edellyttää pääsyä paikallisverkkoon."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumokonekta ang Vesta sa hestia server sa address na ilalagay mo. Sa network ng iyong tahanan, kailangan nito ng access sa lokal na network."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta se connecte au serveur hestia à l’adresse que vous saisissez. Sur votre réseau domestique, cela nécessite l’accès au réseau local."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceanglaíonn Vesta leis an bhfreastalaí hestia ag an seoladh a chuireann tú isteach. Ar do líonra baile, teastaíonn rochtain ar an líonra áitiúil chuige seo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta מתחבר לשרת hestia בכתובת שהזנת. ברשת הביתית שלך נדרשת לשם כך גישה לרשת המקומית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta आपके दर्ज किए गए पते पर hestia सर्वर से जुड़ता है। आपके घरेलू नेटवर्क पर इसके लिए स्थानीय नेटवर्क की पहुँच आवश्यक है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta se povezuje s hestia poslužiteljem na adresi koju unesete. Na vašoj kućnoj mreži za to je potreban pristup lokalnoj mreži."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vesta a megadott címen található hestia-szerverhez csatlakozik. Az otthoni hálózaton ehhez hozzáférés szükséges a helyi hálózathoz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta-ն միանում է ձեր մուտքագրած հասցեով hestia սերվերին։ Ձեր տնային ցանցում դրա համար անհրաժեշտ է տեղային ցանցի հասանելիություն։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta terhubung ke server hestia pada alamat yang Anda masukkan. Di jaringan rumah Anda, koneksi ini memerlukan akses ke jaringan lokal."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta tengist hestia-þjóninum á veffanginu sem þú slærð inn. Á heimanetinu þínu þarf til þess aðgang að staðarnetinu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta si connette al server hestia all’indirizzo che inserisci. Sulla tua rete domestica, questa connessione richiede l’accesso alla rete locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta は入力されたアドレスの hestia サーバーに接続します。ホームネットワーク上で接続するには、ローカルネットワークへのアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta는 입력한 주소의 hestia 서버에 연결합니다. 홈 네트워크에서 연결하려면 로컬 네트워크 접근 권한이 필요합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta jungiasi prie hestia serverio jūsų įvestu adresu. Namų tinkle tam reikia prieigos prie vietinio tinklo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta izveido savienojumu ar hestia serveri jūsu ievadītajā adresē. Mājas tīklā tam ir nepieciešama piekļuve lokālajam tīklam."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta bersambung ke pelayan hestia pada alamat yang anda masukkan. Pada rangkaian rumah anda, sambungan ini memerlukan akses kepada rangkaian setempat."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta သည် သင်ထည့်သွင်းသည့် လိပ်စာရှိ hestia ဆာဗာသို့ ချိတ်ဆက်သည်။ သင့်အိမ်ကွန်ရက်တွင် ချိတ်ဆက်ရန် ဒေသတွင်းကွန်ရက်ကို ဝင်ရောက်အသုံးပြုခွင့် လိုအပ်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta kobler til hestia-serveren på adressen du oppgir. På hjemmenettverket ditt krever dette tilgang til det lokale nettverket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta maakt verbinding met de hestia-server op het adres dat je invoert. Op je thuisnetwerk is hiervoor toegang tot het lokale netwerk nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta łączy się z serwerem hestia pod podanym przez Ciebie adresem. W sieci domowej wymaga to dostępu do sieci lokalnej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vesta se conecta ao servidor hestia no endereço que você informa. Na sua rede doméstica, isso requer acesso à rede local."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta se conectează la serverul hestia de la adresa pe care o introduceți. În rețeaua de acasă, acest lucru necesită acces la rețeaua locală."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta подключается к серверу hestia по введённому вами адресу. В домашней сети для этого необходим доступ к локальной сети."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta sa pripája k serveru hestia na zadanej adrese. Vo vašej domácej sieti je na to potrebný prístup k lokálnej sieti."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta lidhet me serverin hestia në adresën që vendosni. Në rrjetin tuaj të shtëpisë, kjo kërkon qasje në rrjetin lokal."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta se povezuje sa hestia serverom na adresi koju unesete. Na vašoj kućnoj mreži za to je potreban pristup lokalnoj mreži."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta ansluter till hestia-servern på adressen du anger. På ditt hemnätverk kräver detta åtkomst till det lokala nätverket."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta inaunganisha kwenye seva ya hestia kwa anwani unayoingiza. Kwenye mtandao wako wa nyumbani, hii inahitaji ruhusa ya kufikia mtandao wa ndani."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta เชื่อมต่อกับเซิร์ฟเวอร์ hestia ตามที่อยู่ที่คุณป้อน การเชื่อมต่อผ่านเครือข่ายภายในบ้านของคุณต้องได้รับสิทธิ์เข้าถึงเครือข่ายท้องถิ่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta, girdiğiniz adresteki hestia sunucusuna bağlanır. Ev ağınızda bu bağlantı için yerel ağa erişim gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta підключається до сервера hestia за введеною вами адресою. У домашній мережі для цього потрібен доступ до локальної мережі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta kết nối với máy chủ hestia tại địa chỉ bạn nhập. Trên mạng gia đình của bạn, việc này cần quyền truy cập mạng cục bộ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta 会连接到您输入地址的 hestia 服务器。在家庭网络中连接时，需要获得本地网络访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vesta 會連線至您輸入位址的 hestia 伺服器。在家用網路中連線時，需要取得區域網路存取權限。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
