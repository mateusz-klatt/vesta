        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hóa đơn quá lớn đối với máy chủ. Rút ngắn văn bản rồi đọc lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
