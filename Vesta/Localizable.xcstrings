        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rincian item tidak dapat digunakan — struk akan dikonfirmasi berdasarkan jumlah totalnya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki var hægt að nota línurnar — kvittunin verður staðfest út frá heildarupphæðinni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
