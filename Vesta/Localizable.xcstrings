    "This iPhone can’t read Polish characters yet — check ą, ę, ł, ż in product names.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع هذا iPhone قراءة الأحرف البولندية بعد — تحقق من ą, ę, ł, ż في أسماء المنتجات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই iPhone এখনও পোলিশ অক্ষর পড়তে পারে না — পণ্যের নামে ą, ę, ł, ż পরীক্ষা করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj iPhone još ne može čitati poljske znakove — provjeri ą, ę, ł, ż u nazivima proizvoda."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento iPhone zatím neumí číst polské znaky — zkontrolujte ą, ę, ł, ż v názvech produktů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne iPhone kan endnu ikke læse polske tegn — tjek ą, ę, ł, ż i produktnavne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone kann noch keine polnischen Zeichen lesen — prüfe ą, ę, ł, ż in Produktnamen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το iPhone δεν μπορεί ακόμη να διαβάσει πολωνικούς χαρακτήρες — ελέγξτε τα ą, ę, ł, ż στα ονόματα προϊόντων."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone aún no puede leer caracteres polacos: comprueba ą, ę, ł, ż en los nombres de los productos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این iPhone هنوز نمی‌تواند نویسه‌های لهستانی را بخواند — ą, ę, ł, ż را در نام محصولات بررسی کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä iPhone ei osaa vielä lukea puolalaisia merkkejä — tarkista ą, ę, ł, ż tuotenimissä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa mababasa ng iPhone na ito ang mga Polish character — tingnan ang ą, ę, ł, ż sa mga pangalan ng produkto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone ne sait pas encore lire les caractères polonais — vérifiez ą, ę, ł, ż dans les noms des produits."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní féidir leis an iPhone seo carachtair Pholannacha a léamh go fóill — seiceáil ą, ę, ł, ż in ainmneacha táirgí."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-iPhone הזה עדיין לא יכול לקרוא אותיות פולניות — בדוק את ą, ę, ł, ż בשמות המוצרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह iPhone अभी पोलिश अक्षर नहीं पढ़ सकता — उत्पादों के नामों में ą, ę, ł, ż जांचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj iPhone još ne može čitati poljske znakove — provjeri ą, ę, ł, ż u nazivima proizvoda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az iPhone még nem tudja beolvasni a lengyel karaktereket — ellenőrizd az ą, ę, ł, ż karaktereket a terméknevekben."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս iPhone-ը դեռ չի կարող կարդալ լեհական նշանները — ստուգեք ą, ę, ł, ż նիշերը ապրանքների անուններում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ini belum dapat membaca karakter bahasa Polandia — periksa ą, ę, ł, ż pada nama produk."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi iPhone getur enn ekki lesið pólska stafi — athugaðu ą, ę, ł, ż í vöruheitum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo iPhone non riesce ancora a leggere i caratteri polacchi — controlla ą, ę, ł, ż nei nomi dei prodotti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneはポーランド語の文字をまだ読み取れません。商品名の ą, ę, ł, ż を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone은 아직 폴란드어 문자를 읽을 수 없습니다. 제품명에서 ą, ę, ł, ż를 확인하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis iPhone dar nemoka skaityti lenkiškų raidžių — patikrinkite ą, ę, ł, ż prekių pavadinimuose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis iPhone vēl nevar nolasīt poļu rakstzīmes — pārbaudiet ą, ę, ł, ż preču nosaukumos."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ini belum boleh membaca aksara Poland — semak ą, ę, ł, ż dalam nama produk."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဤ iPhone သည် ပိုလန်စာလုံးများကို မဖတ်နိုင်သေးပါ — ကုန်ပစ္စည်းအမည်များတွင် ą, ę, ł, ż ကို စစ်ဆေးပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne iPhonen kan ikke lese polske tegn ennå — kontroller ą, ę, ł, ż i produktnavn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze iPhone kan nog geen Poolse tekens lezen — controleer ą, ę, ł, ż in productnamen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten iPhone nie rozpoznaje jeszcze polskich znaków — sprawdź ą, ę, ł, ż w nazwach produktów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone ainda não consegue ler caracteres poloneses — verifique ą, ę, ł, ż nos nomes dos produtos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest iPhone nu poate citi încă caractere poloneze — verifică ą, ę, ł, ż în numele produselor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот iPhone пока не распознаёт польские буквы — проверьте ą, ę, ł, ż в названиях товаров."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento iPhone zatiaľ nevie čítať poľské znaky — skontrolujte ą, ę, ł, ż v názvoch produktov."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ky iPhone ende nuk mund të lexojë shkronja polake — kontrollo ą, ę, ł, ż në emrat e produkteve."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj iPhone još ne može da čita poljske znakove — proveri ą, ę, ł, ż u nazivima proizvoda."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här iPhonen kan ännu inte läsa polska tecken — kontrollera ą, ę, ł, ż i produktnamn."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone hii bado haiwezi kusoma herufi za Kipolandi — kagua ą, ę, ł, ż katika majina ya bidhaa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone เครื่องนี้ยังอ่านอักษรโปแลนด์ไม่ได้ — โปรดตรวจสอบ ą, ę, ł, ż ในชื่อสินค้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone henüz Lehçe karakterleri okuyamıyor — ürün adlarındaki ą, ę, ł, ż karakterlerini kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей iPhone поки не розпізнає польські літери — перевірте ą, ę, ł, ż у назвах товарів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone này chưa đọc được các ký tự tiếng Ba Lan — hãy kiểm tra ą, ę, ł, ż trong tên sản phẩm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 还无法识别波兰语字符，请检查商品名称中的 ą, ę, ł, ż。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 目前無法辨識波蘭文字元，請檢查商品名稱中的 ą, ę, ł, ż。"
          }
        }
      }
    },
