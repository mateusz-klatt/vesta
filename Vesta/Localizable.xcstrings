          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "hestia har redan 5 parkopplade enheter. Ta bort en från enhetslistan i hestia eller parkoppla med en kod."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tayari kuna vifaa 5 vilivyooanishwa na hestia. Ondoa kimoja kwenye orodha ya vifaa katika hestia, au oanisha kwa kutumia msimbo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "hestia มีอุปกรณ์ที่จับคู่แล้ว 5 เครื่อง ให้นำหนึ่งเครื่องออกจากรายการอุปกรณ์ใน hestia หรือจับคู่ด้วยรหัส"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "hestia ile zaten 5 aygıt eşlenmiş. hestia’daki aygıt listesinden birini kaldırın veya kodla eşleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З hestia вже створено пари для 5 пристроїв. Видаліть один зі списку пристроїв у hestia або створіть пару за допомогою коду."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "hestia đã có 5 thiết bị được ghép đôi. Hãy xóa một thiết bị khỏi danh sách thiết bị trong hestia hoặc ghép đôi bằng mã."
          }
        },
        "zh-Hans": {
          "stringUnit": {
