    "Drafts expire after 48 hours. Scan the receipt again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتهي صلاحية المسودات بعد 48 ساعة. امسح الإيصال ضوئيًا مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "48 ঘন্টা পর খসড়ার মেয়াদ শেষ হয়। রসিদটি আবার স্ক্যান করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nacrti istječu nakon 48 sati. Ponovno skeniraj račun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koncepty vyprší po 48 hodinách. Naskenujte účtenku znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kladder udløber efter 48 timer. Scan kvitteringen igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwürfe laufen nach 48 Stunden ab. Scanne den Beleg erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πρόχειρα λήγουν μετά από 48 ώρες. Σαρώστε ξανά την απόδειξη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los borradores caducan después de 48 horas. Escanea el ticket de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش‌نویس‌ها پس از 48 ساعت منقضی می‌شوند. رسید را دوباره اسکن کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luonnokset vanhenevat 48 tunnin kuluttua. Skannaa kuitti uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mawawalan ng bisa ang mga draft pagkalipas ng 48 oras. I-scan muli ang resibo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les brouillons expirent au bout de 48 heures. Scannez à nouveau le ticket."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Téann dréachtaí in éag tar éis 48 uair an chloig. Scan an admháil arís."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוקף הטיוטות פג לאחר 48 שעות. סרוק שוב את הקבלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ड्राफ़्ट 48 घंटे बाद समाप्त हो जाते हैं। रसीद को फिर से स्कैन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skice istječu nakon 48 sati. Ponovno skeniraj račun."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A piszkozatok 48 óra elteltével lejárnak. Szkenneld be újra a nyugtát."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սևագրերը ժամկետանց են դառնում 48 ժամ հետո: Կրկին սկանավորեք անդորրագիրը:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Draf kedaluwarsa setelah 48 jam. Pindai struk lagi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Drög renna út eftir 48 klukkustundir. Skannaðu kvittunina aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bozze scadono dopo 48 ore. Scansiona di nuovo lo scontrino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下書きは48時間後に期限切れになります。レシートをもう一度スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초안은 48시간 후에 만료됩니다. 영수증을 다시 스캔하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Juodraščiai nustoja galioti po 48 valandų. Dar kartą nuskenuokite kvitą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Melnrakstu derīguma termiņš beidzas pēc 48 stundām. Skenējiet čeku vēlreiz."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Draf luput selepas 48 jam. Imbas resit sekali lagi."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "မူကြမ်းများသည် 48 နာရီကြာလျှင် သက်တမ်းကုန်ဆုံးသည်။ ပြေစာကို ထပ်စကင်န်ဖတ်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utkast utløper etter 48 timer. Skann kvitteringen på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Concepten verlopen na 48 uur. Scan de bon opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szkice wygasają po 48 godzinach. Zeskanuj paragon ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os rascunhos expiram após 48 horas. Escaneie o recibo novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciornele expiră după 48 de ore. Scanează bonul din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия черновиков истекает через 48 часов. Отсканируйте чек ещё раз."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Koncepty vypršia po 48 hodinách. Naskenujte účtenku znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicat skadojnë pas 48 orësh. Skano sërish faturën."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nacrti ističu nakon 48 sati. Ponovo skeniraj račun."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utkast upphör att gälla efter 48 timmar. Skanna kvittot igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasimu zinaisha muda wake baada ya saa 48. Skani risiti tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉบับร่างจะหมดอายุหลังจาก 48 ชั่วโมง สแกนใบเสร็จอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taslakların süresi 48 saat sonra dolar. Fişi yeniden tarayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чернетки стають недійсними через 48 годин. Відскануйте чек ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản nháp hết hạn sau 48 giờ. Quét lại hóa đơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿会在48小时后过期。请重新扫描收据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿會在48小時後過期。請重新掃描收據。"
          }
        }
      }
    },
