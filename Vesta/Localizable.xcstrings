    "Enter just the origin, e.g. https://hestia.example (no path).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الأصل فقط، مثل https://hestia.example (بدون مسار)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু origin লিখুন, যেমন https://hestia.example (কোনো path নয়)।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite samo origin, npr. https://hestia.example (bez putanje)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte jen origin, např. https://hestia.example (bez cesty)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast kun origin, f.eks. https://hestia.example (ingen sti)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib nur den Origin ein, z. B. https://hestia.example (ohne Pfad)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε μόνο το origin, π.χ. https://hestia.example (χωρίς διαδρομή)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce solo el origen, p. ej., https://hestia.example (sin ruta)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط origin را وارد کنید، مثلاً https://hestia.example (بدون مسیر)."
          }
        },
        "fi": {
