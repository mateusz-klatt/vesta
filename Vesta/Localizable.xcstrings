            "value": "အကောင့်ဝင်ရန် ကြိုးစားမှု များလွန်းသည်။ %@ ကြာပြီးမှ ထပ်ကြိုးစားပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange innloggingsforsøk. Prøv igjen om %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel inlogpogingen. Probeer het over %@ opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt wiele prób logowania. Odczekaj %@ i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas tentativas de login. Tente de novo em %@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prea multe încercări de autentificare. Încearcă din nou peste %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много попыток входа. Повторите попытку через %@."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príliš veľa pokusov o prihlásenie. Skúste to znova o %@."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shumë përpjekje për të hyrë. Provo sërish pas %@."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Previše pokušaja prijave. Pokušaj ponovo za %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För många inloggningsförsök. Försök igen om %@."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Umejaribu kuingia mara nyingi sana. Jaribu tena baada ya %@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พยายามเข้าสู่ระบบหลายครั้งเกินไป โปรดลองอีกครั้งในอีก %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla oturum açma denemesi. %@ sonra tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забагато спроб входу. Спробуйте ще раз через %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã thử đăng nhập quá nhiều lần. Hãy thử lại sau %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录尝试次数过多。请在 %@ 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入嘗試次數過多。請在 %@ 後再試。"
          }
        }
      }
    },
