            "state": "translated",
            "value": "سرور نتوانست این رسید را بپذیرد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin ei voinut hyväksyä tätä kuittia."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi matanggap ng server ang resibong ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’a pas pu accepter ce ticket."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níorbh fhéidir leis an bhfreastalaí glacadh leis an admháil seo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השרת לא הצליח לקבל את הקבלה הזאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर इस रसीद को स्वीकार नहीं कर सका।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslužitelj nije mogao prihvatiti ovaj račun."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver nem tudta elfogadni ezt a nyugtát."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
