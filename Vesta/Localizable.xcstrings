    "Your iPhone appears to be offline.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أن iPhone غير متصل بالإنترنت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার iPhone অফলাইনে আছে বলে মনে হচ্ছে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgleda da je vaš iPhone van mreže."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdá se, že iPhone je offline."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din iPhone ser ud til at være offline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein iPhone scheint offline zu sein."
          }
        },
