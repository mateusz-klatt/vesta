    "Shop or NIP changed, so these matches no longer apply. Save without a link, or go back and read the text again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تغيير المتجر أو NIP، لذا لم تعد هذه المطابقات صالحة. احفظ من دون ربط، أو ارجع واقرأ النص مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দোকান বা NIP পরিবর্তন করা হয়েছে, তাই এই মিলগুলি আর প্রযোজ্য নয়। লিংক ছাড়া সংরক্ষণ করুন, অথবা ফিরে গিয়ে টেক্সটটি আবার পড়ুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova podudaranja više ne važe jer su trgovina ili NIP promijenjeni. Sačuvaj bez povezivanja ili se vrati i ponovno pročitaj tekst."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změnil se obchod nebo NIP, takže nalezené shody už neplatí. Uložte bez propojení, nebo se vraťte a text znovu načtěte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Butikken eller NIP er ændret, så disse match gælder ikke længere. Gem uden link, eller gå tilbage og læs teksten igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschäft oder NIP wurden geändert, daher gelten diese Übereinstimmungen nicht mehr. Speichere ohne Verknüpfung oder gehe zurück und lies den Text erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κατάστημα ή το NIP άλλαξε, επομένως αυτές οι αντιστοιχίσεις δεν ισχύουν πλέον. Αποθηκεύστε χωρίς σύνδεση ή επιστρέψτε και διαβάστε ξανά το κείμενο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tienda o el NIP han cambiado, por lo que estas coincidencias ya no son válidas. Guarda sin vincular o vuelve atrás y lee el texto de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فروشگاه یا NIP تغییر کرده است، بنابراین این تطبیق‌ها دیگر معتبر نیستند. بدون پیوند ذخیره کنید یا برگردید و متن را دوباره بخوانید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kauppa tai NIP on muuttunut, joten nämä osumat eivät enää kelpaa. Tallenna ilman linkitystä tai palaa takaisin ja lue teksti uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagbago ang tindahan o NIP, kaya hindi na angkop ang mga match na ito. Mag-save nang walang link, o bumalik at basahin ulit ang text."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le magasin ou le NIP a changé : ces correspondances ne sont donc plus valables. Enregistrez sans lien ou revenez en arrière pour relire le texte."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Athraíodh an siopa nó NIP, mar sin ní bhaineann na meaitseálacha seo a thuilleadh. Sábháil gan nasc, nó téigh ar ais agus léigh an téacs arís."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החנות או NIP השתנו, ולכן ההתאמות האלה כבר לא תקפות. שמור בלי קישור, או חזור וקרא שוב את הטקסט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दुकान या NIP बदल गया है, इसलिए ये मिलान अब लागू नहीं होते। बिना लिंक किए सहेजें, या वापस जाकर टेक्स्ट को फिर से पढ़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promijenili su se trgovina ili NIP, pa ova podudaranja više ne vrijede. Spremi bez povezivanja ili se vrati i ponovno pročitaj tekst."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az üzlet vagy a NIP megváltozott, ezért ezek a találatok már nem érvényesek. Mentsd kapcsolat nélkül, vagy menj vissza, és olvasd be újra a szöveget."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Խանութը կամ NIP-ը փոփոխվել է, ուստի այս համընկնումներն այլևս չեն գործում։ Պահպանեք առանց կապի կամ վերադարձեք և կրկին կարդացեք տեքստը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Toko atau NIP berubah, sehingga kecocokan ini tidak lagi berlaku. Simpan tanpa tautan, atau kembali dan baca teks lagi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Verslun eða NIP hefur breyst, svo þessar samsvaranir gilda ekki lengur. Vistaðu án tengils eða farðu til baka og lestu textann aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Negozio o NIP sono cambiati, quindi queste corrispondenze non sono più valide. Salva senza collegamento oppure torna indietro e leggi di nuovo il testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "店舗またはNIPが変更されたため、これらの一致は無効になりました。リンクせずに保存するか、戻ってテキストをもう一度読み取ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상점 또는 NIP가 변경되어 이 일치 항목은 더 이상 적용되지 않습니다. 연결 없이 저장하거나 돌아가서 텍스트를 다시 읽으세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parduotuvė arba NIP pasikeitė, todėl šie atitikmenys nebegalioja. Išsaugokite be susiejimo arba grįžkite ir dar kartą perskaitykite tekstą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Veikals vai NIP ir mainīts, tāpēc šīs atbilstības vairs nav derīgas. Saglabājiet bez saites vai dodieties atpakaļ un vēlreiz nolasiet tekstu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedai atau NIP telah berubah, jadi padanan ini tidak lagi terpakai. Simpan tanpa pautan, atau kembali dan baca teks semula."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဆိုင် သို့မဟုတ် NIP ပြောင်းလဲသွားသောကြောင့် ဤကိုက်ညီမှုများကို ဆက်လက်အသုံးပြု၍မရတော့ပါ။ လင့်ခ်မပါဘဲ သိမ်းဆည်းပါ သို့မဟုတ် နောက်သို့ပြန်သွား၍ စာသားကို ထပ်ဖတ်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Butikken eller NIP er endret, så disse treffene gjelder ikke lenger. Lagre uten kobling, eller gå tilbake og les teksten på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De winkel of het NIP is gewijzigd, dus deze overeenkomsten zijn niet meer geldig. Bewaar zonder koppeling of ga terug en lees de tekst opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieniono sklep lub NIP, więc te dopasowania są nieaktualne. Zapisz bez powiązania albo wróć i odczytaj tekst ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Houve alteração na loja ou no NIP, portanto estas correspondências não são mais válidas. Salve sem vínculo ou volte e leia o texto novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Magazinul sau NIP s-a schimbat, așa că aceste potriviri nu mai sunt valabile. Salvează fără asociere sau mergi înapoi și citește din nou textul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из-за изменения магазина или NIP эти совпадения больше не действуют. Сохраните без связи или вернитесь назад и снова считайте текст."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obchod alebo NIP sa zmenil, takže tieto zhody už neplatia. Uložte bez prepojenia alebo sa vráťte a znovu načítajte text."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyqani ose NIP ka ndryshuar, ndaj këto përputhje nuk vlejnë më. Ruaj pa lidhje ose kthehu prapa dhe lexo përsëri tekstin."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Prodavnica ili NIP su promenjeni, pa ova podudaranja više ne važe. Sačuvaj bez povezivanja ili se vrati i ponovo pročitaj tekst."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Butiken eller NIP har ändrats, så dessa matchningar gäller inte längre. Spara utan länk eller gå tillbaka och läs texten igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Duka au NIP vimebadilika, hivyo miamala hii inayolingana haitumiki tena. Hifadhi bila kiungo, au rudi nyuma na usome maandishi tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ร้านค้าหรือ NIP เปลี่ยนไปแล้ว รายการที่ตรงกันเหล่านี้จึงใช้ไม่ได้อีกต่อไป บันทึกโดยไม่เชื่อมโยง หรือกลับไปอ่านข้อความอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mağaza veya NIP değiştiği için bu eşleşmeler artık geçerli değil. Bağlantı olmadan kaydedin veya geri dönüp metni yeniden okuyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Через зміну магазину або NIP ці збіги більше не чинні. Збережіть без зв’язку або поверніться й знову зчитайте текст."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cửa hàng hoặc NIP đã thay đổi nên các kết quả trùng khớp này không còn áp dụng được. Lưu mà không liên kết hoặc quay lại và đọc lại văn bản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商店或 NIP 已更改，这些匹配结果不再适用。请保存为不关联，或返回并重新识别文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "商店或 NIP 已更改，這些比對結果不再適用。請儲存但不建立關聯，或返回並重新辨識文字。"
          }
        }
      }
    },
