    "Couldn't reach hestia. Remove this iPhone in hestia's device list.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الاتصال بـ hestia. أزل هذا الـ iPhone من قائمة الأجهزة في hestia."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "hestia-র সঙ্গে সংযোগ করা যায়নি। hestia-র ডিভাইস তালিকা থেকে এই iPhone সরিয়ে দিন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije se moguće povezati s hestijom. Ukloni ovaj iPhone s liste uređaja u hestiji."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se připojit k hestii. Odeberte tento iPhone ze seznamu zařízení v hestii."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke oprette forbindelse til hestia. Fjern denne iPhone fra enhedslisten i hestia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "hestia war nicht erreichbar. Entferne dieses iPhone aus der Geräteliste in hestia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η σύνδεση με το hestia. Αφαιρέστε αυτό το iPhone από τη λίστα συσκευών του hestia."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach hestia. Remove this iPhone in hestia's device list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con hestia. Elimina este iPhone de la lista de dispositivos de hestia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال به hestia ممکن نشد. این iPhone را از فهرست دستگاه‌های hestia حذف کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteyttä hestiaan ei saatu. Poista tämä iPhone hestian laiteluettelosta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi makakonekta sa hestia. Alisin ang iPhone na ito sa listahan ng mga device sa hestia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre hestia. Supprimez cet iPhone de la liste des appareils dans hestia."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níorbh fhéidir ceangal le hestia. Bain an iPhone seo de liosta na ngléasanna in hestia."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה להתחבר ל‑hestia. הסר את ה‑iPhone הזה מרשימת המכשירים ב‑hestia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "hestia से कनेक्ट नहीं हो सका। hestia की डिवाइस सूची से इस iPhone को हटाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezivanje s hestijom nije uspjelo. Ukloni ovaj iPhone s popisa uređaja u hestiji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült csatlakozni a hestiához. Távolítsd el ezt az iPhone-t a hestia eszközlistájáról."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց կապ հաստատել hestia-ի հետ։ Հեռացրեք այս iPhone-ը hestia-ի սարքերի ցանկից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat terhubung ke hestia. Hapus iPhone ini dari daftar perangkat di hestia."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki náðist samband við hestia. Fjarlægðu þennan iPhone af tækjalistanum í hestia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile connettersi a hestia. Rimuovi questo iPhone dall’elenco dei dispositivi in hestia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "hestiaに接続できませんでした。hestiaのデバイス一覧からこのiPhoneを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "hestia에 연결할 수 없습니다. hestia의 기기 목록에서 이 iPhone을 제거하십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
