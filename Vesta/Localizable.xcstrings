    "Camera access is off. Allow access in Settings to scan a sign-in code.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الكاميرا معطّل. اسمح به في الإعدادات لمسح رمز تسجيل الدخول."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যামেরা ব্যবহারের অনুমতি নেই। সাইন-ইন কোড স্ক্যান করতে সেটিংসে অনুমতি দিন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristup kameri je isključen. Omogući ga u postavkama za skeniranje koda za prijavu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přístup k fotoaparátu je vypnutý. Povolte ho v nastavení a naskenujte přihlašovací kód."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraadgang er slået fra. Giv adgang i Indstillinger for at scanne en login-kode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kamerazugriff ist deaktiviert. Erlaube ihn in den Einstellungen, um einen Anmeldecode zu scannen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πρόσβαση στην κάμερα είναι απενεργοποιημένη. Επιτρέψτε την στις Ρυθμίσεις για σάρωση του κωδικού σύνδεσης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is off. Allow access in Settings to scan a sign-in code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la cámara está desactivado. Permítelo en Ajustes para escanear un código de inicio de sesión."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به دوربین غیرفعال است. برای اسکن کد ورود، آن را در تنظیمات فعال کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameran käyttö ei ole sallittu. Salli se Asetuksissa, jotta voit skannata kirjautumiskoodin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-off ang access sa camera. Payagan ito sa Mga Setting para mag-scan ng code sa pag-sign in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à l’appareil photo est désactivé. Autorisez-le dans Réglages pour scanner un code de connexion."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá rochtain ar an gceamara múchta. Ceadaigh rochtain sna Socruithe chun cód logála isteach a scanadh."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה למצלמה כבויה. יש לאפשר אותה בהגדרות כדי לסרוק קוד כניסה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे की अनुमति बंद है। साइन-इन कोड स्कैन करने के लिए सेटिंग्स में अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristup kameri je isključen. Omogući ga u postavkama za skeniranje koda za prijavu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kamerához nincs hozzáférés. A bejelentkezési kód beolvasásához engedélyezd a Beállításokban."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տեսախցիկի հասանելիությունն անջատված է։ Մուտքի կոդը սկանավորելու համար միացրեք այն կարգավորումներում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses kamera nonaktif. Izinkan akses di Pengaturan untuk memindai kode masuk."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Slökkt er á aðgangi að myndavélinni. Leyfðu aðgang í Stillingum til að skanna innskráningarkóða."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso alla fotocamera è disattivato. Consentilo in Impostazioni per scansionare un codice di accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラへのアクセスがオフです。サインインコードを読み取るには「設定」で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 접근이 꺼져 있습니다. 로그인 코드를 스캔하려면 설정에서 접근을 허용하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prieiga prie kameros išjungta. Norėdami nuskaityti prisijungimo kodą, suteikite prieigą nustatymuose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piekļuve kamerai ir izslēgta. Lai skenētu pierakstīšanās kodu, atļaujiet piekļuvi iestatījumos."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses kamera dimatikan. Benarkan akses dalam Tetapan untuk mengimbas kod log masuk."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ကင်မရာ အသုံးပြုခွင့်ကို ပိတ်ထားသည်။ အကောင့်ဝင်ကုဒ်ကို စကင်ဖတ်ရန် ဆက်တင်များတွင် ခွင့်ပြုပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameratilgang er slått av. Gi tilgang i Innstillinger for å skanne en innloggingskode."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cameratoegang is uitgeschakeld. Geef toegang in Instellingen om een inlogcode te scannen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do aparatu jest wyłączony. Włącz go w Ustawieniach, aby zeskanować kod logowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmera está desativado. Permita o acesso nos Ajustes para escanear um código de login."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesul la cameră este dezactivat. Permite-l în Configurări pentru a scana un cod de autentificare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к камере отключён. Разрешите его в настройках, чтобы отсканировать код входа."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prístup k fotoaparátu je vypnutý. Povoľte ho v nastaveniach, aby ste mohli naskenovať prihlasovací kód."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Qasja te kamera është e çaktivizuar. Lejoje te Cilësimet për të skanuar kodin e hyrjes."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristup kameri je isključen. Dozvoli ga u podešavanjima za skeniranje koda za prijavu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraåtkomst är avstängd. Tillåt åtkomst i Inställningar för att skanna en inloggningskod."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ufikiaji wa kamera umezimwa. Uruhusu kwenye Mipangilio ili kuchanganua msimbo wa kuingia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้อนุญาตให้ใช้กล้อง เปิดสิทธิ์ในการตั้งค่าเพื่อสแกนรหัสเข้าสู่ระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera erişimi kapalı. Oturum açma kodunu taramak için Ayarlar’dan erişime izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до камери вимкнено. Надайте доступ у Параметрах, щоб відсканувати код входу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập camera đang tắt. Hãy bật quyền trong Cài đặt để quét mã đăng nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机权限已关闭。请在“设置”中允许访问相机，以扫描登录码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機權限已關閉。請在「設定」中允許取用相機，以掃描登入碼。"
          }
        }
      }
    },
