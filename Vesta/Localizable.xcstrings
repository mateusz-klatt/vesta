          "stringUnit": {
            "state": "translated",
            "value": "Votre iPhone semble être hors ligne."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Is cosúil go bhfuil do iPhone as líne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נראה שה-iPhone שלך לא מחובר לאינטרנט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगता है आपका iPhone ऑफ़लाइन है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čini se da je vaš iPhone izvan mreže."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Úgy tűnik, az iPhone offline."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կարծես ձեր iPhone-ը անցանց է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Anda tampaknya offline."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone virðist vera án nettengingar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra che iPhone sia offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneがオフラインのようです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone이 오프라인인 것 같습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrodo, kad jūsų iPhone neprisijungęs."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šķiet, ka jūsu iPhone ir bezsaistē."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone anda nampaknya di luar talian."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "သင့် iPhone သည် အော့ဖ်လိုင်းဖြစ်နေပုံရသည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ser ut til å være frakoblet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je iPhone lijkt offline te zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygląda na to, że iPhone jest offline."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que seu iPhone está offline."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-ul pare să fie offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, iPhone не подключен к сети."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdá sa, že iPhone je offline."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Duket se iPhone është jashtë linje."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgleda da je iPhone van mreže."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din iPhone verkar vara offline."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inaonekana iPhone yako iko nje ya mtandao."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูเหมือนว่า iPhone ของคุณออฟไลน์อยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone çevrimdışı görünüyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схоже, iPhone офлайн."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có vẻ iPhone của bạn đang ngoại tuyến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 iPhone 似乎已离线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 iPhone 似乎已離線。"
          }
        }
      }
    },
