    "Too many receipts, try again in a minute": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيصالات كثيرة جدًا، حاول مرة أخرى بعد دقيقة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনেক বেশি রসিদ, এক মিনিট পরে আবার চেষ্টা করুন"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Previše računa, pokušaj ponovo za minutu"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příliš mnoho účtenek, zkuste to znovu za minutu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange kvitteringer, prøv igen om et minut"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Belege, versuche es in einer Minute erneut"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάρα πολλές αποδείξεις, δοκιμάστε ξανά σε ένα λεπτό"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados tickets, inténtalo de nuevo en un minuto"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعداد رسیدها بیش از حد است، یک دقیقه دیگر دوباره تلاش کنید"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liikaa kuitteja, yritä uudelleen minuutin kuluttua"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Masyadong maraming resibo, subukan ulit pagkalipas ng isang minuto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tickets, réessayez dans une minute"
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "An iomarca admhálacha, bain triail eile as i gceann nóiméid"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יותר מדי קבלות, נסה שוב בעוד דקה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत ज़्यादा रसीदें, एक मिनट बाद फिर कोशिश करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Previše računa, pokušaj ponovno za minutu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Túl sok nyugta, próbáld újra egy perc múlva"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չափազանց շատ անդորրագրեր, կրկին փորձեք մեկ րոպեից"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak struk, coba lagi dalam satu menit"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Of margar kvittanir, reyndu aftur eftir mínútu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi scontrini, riprova tra un minuto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートが多すぎるため、1分後にもう一度お試しください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영수증이 너무 많으니, 1분 후 다시 시도하십시오"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Per daug kvitų, bandykite dar kartą po minutės"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārāk daudz čeku, mēģiniet vēlreiz pēc minūtes"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak resit, cuba lagi dalam seminit"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ပြေစာများလွန်းသည်၊ တစ်မိနစ်အကြာတွင် ထပ်မံကြိုးစားပါ"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange kvitteringer, prøv igjen om et minutt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel bonnen, probeer het over een minuut opnieuw"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za dużo paragonów. Spróbuj ponownie za minutę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibos demais, tente novamente em um minuto"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prea multe bonuri, încearcă din nou peste un minut"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много чеков, повторите попытку через минуту"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Priveľa účteniek, skúste to znova o minútu"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shumë fatura, provo përsëri pas një minute"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Previše računa, pokušaj ponovo za minut"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För många kvitton, försök igen om en minut"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Risiti ni nyingi mno, jaribu tena baada ya dakika moja"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใบเสร็จมากเกินไป ลองอีกครั้งในอีกหนึ่งนาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
