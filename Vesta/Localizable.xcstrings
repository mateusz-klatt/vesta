          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो के बीच का मिलान अनुमान के आधार पर किया गया है। पुष्टि करने से पहले रसीद की पंक्तियाँ जाँचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preklapanje fotografija je procijenjeno. Prije potvrde provjerite stavke računa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fotók átfedését becsléssel állapítottuk meg. A jóváhagyás előtt ellenőrizd a nyugta sorait."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Լուսանկարների համընկնումը մոտավոր է հաշվարկվել։ Հաստատելուց առաջ ստուգեք կտրոնի տողերը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumpang tindih antar foto telah diperkirakan. Periksa baris pada struk sebelum mengonfirmasi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Áætlað var hvar myndirnar skarast. Athugaðu línurnar á kvittuninni áður en þú staðfestir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sovrapposizione delle foto è stata stimata. Controlla le righe dello scontrino prima di confermare."
          }
        },
        "ja": {
