    "Couldn’t pair this iPhone. Check the code or get a new one from hestia and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إقران جهاز iPhone هذا. تحقق من الرمز أو احصل على رمز جديد من hestia وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই iPhone পেয়ার করা যায়নি। কোডটি যাচাই করুন অথবা hestia থেকে নতুন কোড নিয়ে আবার চেষ্টা করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uparivanje ovog iPhone uređaja nije uspjelo. Provjeri kod ili preuzmi novi iz sistema hestia i pokušaj ponovo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento iPhone se nepodařilo spárovat. Zkontrolujte kód nebo si v systému hestia vygenerujte nový a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke danne par med denne iPhone. Kontrollér koden, eller hent en ny fra hestia, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone konnte nicht gekoppelt werden. Prüfe den Code oder hole einen neuen von hestia und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η ζευγοποίηση αυτού του iPhone. Ελέγξτε τον κωδικό ή λάβετε έναν νέο από το hestia και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido enlazar este iPhone. Comprueba el código u obtén uno nuevo en hestia e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جفت‌سازی این iPhone انجام نشد. کد را بررسی کنید یا کد جدیدی از hestia بگیرید و دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tästä iPhonesta ei voitu muodostaa laiteparia. Tarkista koodi tai hae uusi hestia-palvelimelta ja yritä uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ma-pair ang iPhone na ito. Suriin ang code o kumuha ng bago sa hestia at subukan ulit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de jumeler cet iPhone. Vérifiez le code ou obtenez-en un nouveau dans hestia et réessayez."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níorbh fhéidir an iPhone seo a phéireáil. Seiceáil an cód nó faigh ceann nua ó hestia agus bain triail eile as."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לקשר את ה-iPhone הזה. בדוק את הקוד או קבל קוד חדש מ-hestia ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस iPhone को पेयर नहीं किया जा सका। कोड जाँचें या hestia से नया कोड लेकर फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uparivanje ovog iPhone uređaja nije uspjelo. Provjeri kod ili preuzmi novi iz sustava hestia i pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült párosítani ezt az iPhone készüléket. Ellenőrizd a kódot, vagy kérj újat a hestia rendszerből, és próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց զուգակցել այս iPhone-ը։ Ստուգեք կոդը կամ նոր կոդ ստացեք hestia-ից և կրկին փորձեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ini tidak dapat dipasangkan. Periksa kode atau dapatkan kode baru dari hestia dan coba lagi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að para þennan iPhone. Athugaðu kóðann eða fáðu nýjan frá hestia og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile abbinare questo iPhone. Controlla il codice o richiedine uno nuovo su hestia e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneをペアリングできませんでした。コードを確認するか、hestiaで新しいコードを取得して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone을 페어링할 수 없습니다. 코드를 확인하거나 hestia에서 새 코드를 받아 다시 시도하십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko susieti šio iPhone. Patikrinkite kodą arba gaukite naują iš hestia ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neizdevās savienot šo iPhone pārī. Pārbaudiet kodu vai iegūstiet jaunu sistēmā hestia un mēģiniet vēlreiz."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ini tidak dapat dipasangkan. Semak kod atau dapatkan kod baharu daripada hestia dan cuba lagi."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဤ iPhone ကို တွဲချိတ်၍ မရပါ။ ကုဒ်ကို စစ်ဆေးပါ သို့မဟုတ် hestia မှ ကုဒ်အသစ် ရယူပြီး ထပ်မံကြိုးစားပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke sammenkoble denne iPhonen. Kontroller koden eller hent en ny fra hestia og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze iPhone kon niet worden gekoppeld. Controleer de code of haal een nieuwe op bij hestia en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się sparować tego iPhone’a. Sprawdź kod lub pobierz nowy w hestii i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível emparelhar este iPhone. Verifique o código ou obtenha um novo no hestia e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut asocia acest iPhone. Verifică codul sau obține unul nou din hestia și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать пару с этим iPhone. Проверьте код или получите новый в hestia и повторите попытку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento iPhone sa nepodarilo spárovať. Skontrolujte kód alebo si v systéme hestia vygenerujte nový a skúste to znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuk u arrit çiftimi i këtij iPhone. Kontrollo kodin ose merr një të ri nga hestia dhe provo përsëri."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Uparivanje ovog iPhone uređaja nije uspelo. Proveri kôd ili preuzmi novi iz sistema hestia i pokušaj ponovo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att parkoppla denna iPhone. Kontrollera koden eller hämta en ny från hestia och försök igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imeshindwa kuoanisha iPhone hii. Angalia msimbo au pata mpya kutoka hestia na ujaribu tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถจับคู่ iPhone เครื่องนี้ได้ ตรวจสอบรหัสหรือรับรหัสใหม่จาก hestia แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone eşlenemedi. Kodu kontrol edin veya hestia üzerinden yeni bir kod alıp tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося створити пару з цим iPhone. Перевірте код або отримайте новий у hestia й повторіть спробу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể ghép đôi iPhone này. Kiểm tra mã hoặc lấy mã mới từ hestia rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法配对这部iPhone。请检查代码或从hestia获取新代码，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法配對這部iPhone。請檢查代碼或從hestia取得新代碼，然後再試一次。"
          }
        }
      }
    },
    "Couldn’t update pairing on this iPhone. Try again while it’s unlocked.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحديث الاقتران على جهاز iPhone هذا. حاول مرة أخرى وهو مفتوح القفل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই iPhone-এর পেয়ারিং আপডেট করা যায়নি। এটি আনলক করে আবার চেষ্টা করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ažuriranje uparivanja na ovom iPhone uređaju nije uspjelo. Pokušaj ponovo dok je otključan."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Párování na tomto zařízení iPhone se nepodařilo aktualizovat. Zkuste to znovu, až bude odemčené."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke opdatere pardannelsen på denne iPhone. Prøv igen, mens den er låst op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopplung auf diesem iPhone konnte nicht aktualisiert werden. Versuche es erneut, während es entsperrt ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η ενημέρωση της ζευγοποίησης σε αυτό το iPhone. Δοκιμάστε ξανά ενώ είναι ξεκλείδωτο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido actualizar el enlace en este iPhone. Inténtalo de nuevo mientras está desbloqueado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌روزرسانی جفت‌سازی در این iPhone انجام نشد. وقتی قفل آن باز است دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän iPhonen laiteparia ei voitu päivittää. Yritä uudelleen, kun sen lukitus on avattu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ma-update ang pagpapares sa iPhone na ito. Subukan ulit habang naka-unlock ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de mettre à jour le jumelage sur cet iPhone. Réessayez lorsqu’il est déverrouillé."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níorbh fhéidir an phéireáil ar an iPhone seo a nuashonrú. Bain triail eile as agus é díghlasáilte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לעדכן את הקישור ב-iPhone הזה. נסה שוב כשהוא לא נעול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस iPhone पर पेयरिंग अपडेट नहीं की जा सकी। इसे अनलॉक करके फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ažuriranje uparivanja na ovom iPhone uređaju nije uspjelo. Pokušaj ponovno dok je otključan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült frissíteni a párosítást ezen az iPhone készüléken. Próbáld újra, amikor fel van oldva."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Չհաջողվեց թարմացնել զուգակցումն այս iPhone-ում։ Կրկին փորձեք, երբ այն ապակողպված է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemasangan di iPhone ini tidak dapat diperbarui. Coba lagi saat iPhone tidak terkunci."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að uppfæra pörun á þessum iPhone. Reyndu aftur meðan hann er ólæstur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aggiornare l’abbinamento su questo iPhone. Riprova mentre è sbloccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneのペアリングを更新できませんでした。ロックを解除した状態で、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone의 페어링을 업데이트할 수 없습니다. 잠금 해제 상태에서 다시 시도하십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepavyko atnaujinti susiejimo šiame iPhone. Bandykite dar kartą, kai jis atrakintas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neizdevās atjaunināt savienojumu pārī šajā iPhone. Mēģiniet vēlreiz, kamēr tas ir atbloķēts."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemasangan pada iPhone ini tidak dapat dikemas kini. Cuba lagi semasa iPhone tidak dikunci."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဤ iPhone ပေါ်ရှိ တွဲချိတ်မှုကို အပ်ဒိတ်လုပ်၍ မရပါ။ လော့ခ်ဖွင့်ထားစဉ် ထပ်မံကြိုးစားပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke oppdatere sammenkoblingen på denne iPhonen. Prøv igjen mens den er låst opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De koppeling op deze iPhone kon niet worden bijgewerkt. Probeer het opnieuw terwijl deze is ontgrendeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zmienić parowania na tym iPhonie. Odblokuj go i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atualizar o emparelhamento neste iPhone. Tente novamente enquanto ele estiver desbloqueado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut actualiza asocierea pe acest iPhone. Încearcă din nou când este deblocat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обновить сопряжение на этом iPhone. Повторите попытку, когда он разблокирован."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Párovanie na tomto iPhone sa nepodarilo aktualizovať. Skúste to znova, keď bude odomknutý."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuk u arrit përditësimi i çiftimit në këtë iPhone. Provo përsëri kur të jetë i zhbllokuar."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ažuriranje uparivanja na ovom iPhone uređaju nije uspelo. Pokušaj ponovo dok je otključan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att uppdatera parkopplingen på denna iPhone. Försök igen när den är upplåst."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imeshindwa kusasisha uoanishaji kwenye iPhone hii. Jaribu tena ikiwa haijafungwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถอัปเดตการจับคู่บน iPhone เครื่องนี้ได้ ลองอีกครั้งขณะที่ปลดล็อคอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone üzerindeki eşleme güncellenemedi. Kilidi açıkken tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося оновити пару на цьому iPhone. Повторіть спробу, коли він розблокований."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể cập nhật ghép đôi trên iPhone này. Thử lại khi iPhone đang mở khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新这部iPhone的配对。请在解锁状态下重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法更新這部iPhone的配對。請在解鎖狀態下再試一次。"
          }
        }
      }
    },
    "Enter the 8-character pairing code from hestia.": {
