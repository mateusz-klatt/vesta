        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใบเสร็จมีขนาดใหญ่เกินไปสำหรับเซิร์ฟเวอร์ โปรดย่อข้อความแล้วอ่านอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
