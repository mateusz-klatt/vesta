    "Drafts expire after 48 hours. Scan the receipt again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتهي صلاحية المسودات بعد 48 ساعة. امسح الإيصال ضوئيًا مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "48 ঘন্টা পর খসড়ার মেয়াদ শেষ হয়। রসিদটি আবার স্ক্যান করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nacrti istječu nakon 48 sati. Ponovno skeniraj račun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koncepty vyprší po 48 hodinách. Naskenujte účtenku znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kladder udløber efter 48 timer. Scan kvitteringen igen."
          }
        },
