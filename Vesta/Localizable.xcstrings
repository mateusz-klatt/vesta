    "Too many pairing attempts. Try again in a minute.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات اقتران كثيرة جدًا. حاول مرة أخرى بعد دقيقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনেকবার পেয়ার করার চেষ্টা করা হয়েছে। এক মিনিট পরে আবার চেষ্টা করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Previše pokušaja uparivanja. Pokušaj ponovo za minutu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příliš mnoho pokusů o spárování. Zkuste to znovu za minutu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange forsøg på pardannelse. Prøv igen om et minut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Kopplungsversuche. Versuche es in einer Minute erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάρα πολλές προσπάθειες ζευγοποίησης. Δοκιμάστε ξανά σε ένα λεπτό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many pairing attempts. Try again in a minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos de enlace. Inténtalo de nuevo en un minuto."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعداد تلاش‌ها برای جفت‌سازی بیش از حد است. یک دقیقه دیگر دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liian monta pariliitosyritystä. Yritä uudelleen minuutin kuluttua."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Masyadong maraming pagsubok na magpares. Subukan ulit pagkalipas ng isang minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives de jumelage. Réessayez dans une minute."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinneadh an iomarca iarrachtaí péireála. Bain triail eile as i gceann nóiméid."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יותר מדי ניסיונות קישור. נסה שוב בעוד דקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेयर करने की बहुत ज़्यादा कोशिशें हुईं। एक मिनट बाद फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Previše pokušaja uparivanja. Pokušaj ponovno za minutu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Túl sok párosítási kísérlet. Próbáld újra egy perc múlva."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Զուգակցման չափազանց շատ փորձեր։ Կրկին փորձեք մեկ րոպեից։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak percobaan pemasangan. Coba lagi dalam satu menit."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Of margar pörunartilraunir. Reyndu aftur eftir eina mínútu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi tentativi di abbinamento. Riprova tra un minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングの試行回数が多すぎます。1分後にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링 시도 횟수가 너무 많습니다. 1분 후 다시 시도하십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Per daug bandymų susieti. Bandykite dar kartą po minutės."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārāk daudz mēģinājumu savienot pārī. Mēģiniet vēlreiz pēc minūtes."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak percubaan pemasangan. Cuba lagi dalam seminit."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "တွဲချိတ်ရန် ကြိုးစားမှု များလွန်းသည်။ တစ်မိနစ်အကြာတွင် ထပ်ကြိုးစားပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange forsøk på sammenkobling. Prøv igjen om et minutt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel koppelpogingen. Probeer het over een minuut opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za dużo prób parowania. Spróbuj ponownie za minutę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas tentativas de emparelhamento. Tente novamente em um minuto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prea multe încercări de asociere. Încearcă din nou peste un minut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много попыток сопряжения. Повторите попытку через минуту."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príliš veľa pokusov o spárovanie. Skúste to znova o minútu."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shumë përpjekje për çiftim. Provo përsëri pas një minute."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Previše pokušaja uparivanja. Pokušaj ponovo za minut."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För många parkopplingsförsök. Försök igen om en minut."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Majaribio mengi mno ya kuoanisha. Jaribu tena baada ya dakika moja."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พยายามจับคู่หลายครั้งเกินไป ลองอีกครั้งในอีกหนึ่งนาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla eşleme denemesi yapıldı. Bir dakika sonra tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забагато спроб створити пару. Повторіть спробу за хвилину."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã thử ghép đôi quá nhiều lần. Hãy thử lại sau một phút."
