    "Too many sign-in attempts. Try again later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات تسجيل دخول كثيرة. حاول مجددًا لاحقًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাইন-ইনের চেষ্টা অনেকবার করা হয়েছে। পরে আবার চেষ্টা করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Previše pokušaja prijave. Pokušaj ponovo kasnije."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příliš mnoho pokusů o přihlášení. Zkuste to později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange loginforsøg. Prøv igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Anmeldeversuche. Versuche es später erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάρα πολλές προσπάθειες σύνδεσης. Δοκιμάστε ξανά αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many sign-in attempts. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos de inicio de sesión. Inténtalo más tarde."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعداد تلاش‌های ورود زیاد است. بعداً دوباره امتحان کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liian monta kirjautumisyritystä. Yritä myöhemmin uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Masyadong maraming beses sinubukang mag-sign in. Subukan ulit mamaya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives de connexion. Réessayez plus tard."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinneadh an iomarca iarrachtaí logála isteach. Bain triail eile as ar ball."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יותר מדי ניסיונות כניסה. כדאי לנסות שוב מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन करने की बहुत ज़्यादा कोशिशें हुईं। बाद में फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Previše pokušaja prijave. Pokušaj ponovno kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Túl sok bejelentkezési kísérlet. Próbáld újra később."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտք գործելու չափազանց շատ փորձեր։ Նորից փորձեք ավելի ուշ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak percobaan masuk. Coba lagi nanti."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Of margar innskráningartilraunir. Reyndu aftur síðar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi tentativi di accesso. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインの試行回数が多すぎます。しばらくしてから再試行してください。"
