    "Text is read on this iPhone. Only the text is sent to your server, with card numbers removed. The photo is not saved or uploaded.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُقرأ النص على هذا iPhone. يُرسل النص فقط إلى الخادم الخاص بك بعد حذف أرقام البطاقات. لا يتم حفظ الصورة أو رفعها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই iPhone-এই টেক্সট পড়া হয়। কার্ড নম্বর মুছে ফেলার পর শুধুমাত্র টেক্সট আপনার সার্ভারে পাঠানো হয়। ছবিটি সংরক্ষণ বা আপলোড করা হয় না।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst se čita na ovom iPhoneu. Na tvoj server šalje se samo tekst, bez brojeva kartica. Fotografija se ne sprema niti učitava."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text se čte přímo v tomto iPhonu. Na váš server se odesílá pouze text bez čísel karet. Fotka se neukládá ani nenahrává."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksten læses på denne iPhone. Kun teksten sendes til din server, og kortnumre fjernes. Fotoet hverken gemmes eller uploades."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text wird auf diesem iPhone gelesen. Nur der Text wird an deinen Server gesendet, ohne Kartennummern. Das Foto wird weder gespeichert noch hochgeladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κείμενο διαβάζεται σε αυτό το iPhone. Στον διακομιστή σας αποστέλλεται μόνο το κείμενο, χωρίς τους αριθμούς καρτών. Η φωτογραφία δεν αποθηκεύεται ούτε μεταφορτώνεται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto se lee en este iPhone. Solo se envía el texto a tu servidor, sin los números de las tarjetas. La foto no se guarda ni se sube."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "متن روی همین iPhone خوانده می‌شود. فقط متن، بدون شماره کارت‌ها، به سرور شما ارسال می‌شود. عکس ذخیره یا بارگذاری نمی‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksti luetaan tällä iPhonella. Palvelimellesi lähetetään vain teksti, josta korttinumerot on poistettu. Kuvaa ei tallenneta eikä lähetetä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binabasa ang text sa iPhone na ito. Ang text lang ang ipinapadala sa server mo, na tinanggal ang mga card number. Hindi sine-save o ina-upload ang larawan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte est lu sur cet iPhone. Seul le texte est envoyé à votre serveur, sans les numéros de carte. La photo n’est ni enregistrée ni téléversée."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Léitear an téacs ar an iPhone seo. Ní sheoltar ach an téacs chuig do fhreastalaí, agus uimhreacha na gcártaí bainte de. Ní shábháiltear agus ní uaslódáiltear an grianghraf."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטקסט נקרא ב-iPhone הזה. רק הטקסט נשלח לשרת שלך, ללא מספרי כרטיסים. התמונה לא נשמרת ולא מועלית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट इसी iPhone पर पढ़ा जाता है। आपके सर्वर पर केवल टेक्स्ट भेजा जाता है, कार्ड नंबर हटा दिए जाते हैं। फ़ोटो न तो सहेजी जाती है और न ही अपलोड की जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst se čita na ovom iPhoneu. Na tvoj poslužitelj šalje se samo tekst, bez brojeva kartica. Fotografija se ne sprema niti učitava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szöveget ez az iPhone olvassa be. Csak a szöveg kerül elküldésre a szerveredre, a kártyaszámok eltávolításával. A fotó nem kerül mentésre vagy feltöltésre."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տեքստը կարդացվում է այս iPhone-ում։ Ձեր սերվեր է ուղարկվում միայն տեքստը՝ առանց քարտերի համարների։ Լուսանկարը չի պահպանվում և չի վերբեռնվում։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks dibaca di iPhone ini. Hanya teks yang dikirim ke server Anda, dengan nomor kartu dihapus. Foto tidak disimpan atau diunggah."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Textinn er lesinn á þessum iPhone. Aðeins textinn er sendur á þjóninn þinn, með kortanúmerum fjarlægðum. Myndin er ekki vistuð og henni er ekki hlaðið upp."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo viene letto su questo iPhone. Al tuo server viene inviato solo il testo, senza i numeri delle carte. La foto non viene salvata né caricata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストの読み取りはこのiPhone上で行われます。サーバーに送信されるのは、カード番号を除いたテキストのみです。写真が保存・アップロードされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트는 이 iPhone에서 읽힙니다. 카드 번호를 제거한 텍스트만 서버로 전송됩니다. 사진은 저장되거나 업로드되지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstas nuskaitomas šiame iPhone. Į jūsų serverį siunčiamas tik tekstas, iš kurio pašalinti kortelių numeriai. Nuotrauka neišsaugoma ir neįkeliama."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksts tiek nolasīts šajā iPhone. Uz jūsu serveri tiek nosūtīts tikai teksts, no kura izņemti karšu numuri. Fotoattēls netiek ne saglabāts, ne augšupielādēts."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks dibaca pada iPhone ini. Hanya teks dihantar ke pelayan anda, dengan nombor kad dikeluarkan. Foto tidak disimpan atau dimuat naik."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဤ iPhone ပေါ်တွင် စာသားကို ဖတ်ရှုသည်။ ကတ်နံပါတ်များဖယ်ရှားပြီးသော စာသားကိုသာ သင့်ဆာဗာသို့ ပို့သည်။ ဓာတ်ပုံကို သိမ်းဆည်းခြင်း သို့မဟုတ် အပ်လုဒ်လုပ်ခြင်း မပြုပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksten leses på denne iPhonen. Bare teksten sendes til serveren din, med kortnumre fjernet. Bildet verken lagres eller lastes opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tekst wordt op deze iPhone gelezen. Alleen de tekst wordt naar je server gestuurd, zonder kaartnummers. De foto wordt niet bewaard of geüpload."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst jest odczytywany na tym iPhonie. Na Twój serwer trafia tylko tekst, bez numerów kart. Zdjęcie nie jest zapisywane ani wysyłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto é lido neste iPhone. Somente o texto é enviado ao seu servidor, com os números dos cartões removidos. A foto não é salva nem enviada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Textul este citit pe acest iPhone. Doar textul este trimis către serverul tău, fără numerele cardurilor. Fotografia nu este nici salvată, nici încărcată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст распознаётся на этом iPhone. На ваш сервер отправляется только текст без номеров карт. Фото не сохраняется и не загружается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Text sa číta v tomto iPhone. Na váš server sa odošle len text bez čísel kariet. Fotka sa neukladá ani nenahráva."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksti lexohet në këtë iPhone. Vetëm teksti i dërgohet serverit tënd, me numrat e kartave të hequr. Fotoja nuk ruhet dhe nuk ngarkohet."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst se čita na ovom iPhone-u. Na tvoj server šalje se samo tekst, bez brojeva kartica. Fotografija se ne čuva niti otprema."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Texten läses på den här iPhonen. Endast texten skickas till din server, med kortnummer borttagna. Fotot varken sparas eller laddas upp."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Maandishi husomwa kwenye iPhone hii. Maandishi pekee hutumwa kwa seva yako, baada ya namba za kadi kuondolewa. Picha haihifadhiwi wala kupakiwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความจะถูกอ่านบน iPhone เครื่องนี้ เฉพาะข้อความที่ลบหมายเลขบัตรแล้วเท่านั้นที่ส่งไปยังเซิร์ฟเวอร์ของคุณ รูปภาพจะไม่ถูกบันทึกหรืออัปโหลด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin bu iPhone’da okunur. Sunucunuza yalnızca kart numaraları kaldırılmış metin gönderilir. Fotoğraf ne kaydedilir ne de yüklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст зчитується на цьому iPhone. На ваш сервер надсилається лише текст без номерів карток. Фото не зберігається й не завантажується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản được đọc trên iPhone này. Chỉ văn bản đã xóa số thẻ được gửi đến máy chủ của bạn. Ảnh không được lưu hoặc tải lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本在此 iPhone 上读取。仅文本会发送到你的服务器，卡号会被移除。照片不会存储或上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字會在此 iPhone 上讀取。只有移除卡號後的文字會傳送到你的伺服器。照片不會儲存或上傳。"
          }
        }
      }
    },
    "The receipt is too large for the server. Shorten the text and read it again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإيصال كبير جدًا بالنسبة إلى الخادم. اختصر النص واقرأه مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রসিদটি সার্ভারের জন্য খুব বড়। টেক্সট ছোট করে আবার পড়ুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Račun je prevelik za server. Skrati tekst i ponovno ga pročitaj."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Účtenka je pro server příliš velká. Zkraťte text a načtěte ho znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvitteringen er for stor til serveren. Forkort teksten, og læs den igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Beleg ist zu groß für den Server. Kürze den Text und lies ihn erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απόδειξη είναι πολύ μεγάλη για τον διακομιστή. Συντομεύστε το κείμενο και διαβάστε το ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ticket es demasiado grande para el servidor. Acorta el texto y léelo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رسید برای سرور بیش از حد بزرگ است. متن را کوتاه کنید و دوباره بخوانید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuitti on liian suuri palvelimelle. Lyhennä tekstiä ja lue se uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Masyadong malaki ang resibo para sa server. Paikliin ang text at basahin ito ulit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ticket est trop volumineux pour le serveur. Raccourcissez le texte et relisez-le."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá an admháil ró-mhór don fhreastalaí. Giorraigh an téacs agus léigh arís é."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקבלה גדולה מדי עבור השרת. קצר את הטקסט וקרא אותו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रसीद सर्वर के लिए बहुत बड़ी है। टेक्स्ट छोटा करें और उसे फिर से पढ़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Račun je prevelik za poslužitelj. Skrati tekst i ponovno ga pročitaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nyugta túl nagy a szerver számára. Rövidítsd a szöveget, és olvasd be újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անդորրագիրը չափազանց մեծ է սերվերի համար։ Կարճացրեք տեքստը և կրկին կարդացեք այն։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Struk terlalu besar untuk server. Persingkat teks lalu baca lagi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvittunin er of stór fyrir þjóninn. Styttu textann og lestu hann aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scontrino è troppo grande per il server. Accorcia il testo e leggilo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートが大きすぎてサーバーに送信できません。テキストを短くして、もう一度読み取ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영수증이 너무 커서 서버에서 처리할 수 없습니다. 텍스트를 줄이고 다시 읽으세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvitas per didelis serveriui. Sutrumpinkite tekstą ir dar kartą jį perskaitykite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Čeks ir pārāk liels serverim. Saīsiniet tekstu un nolasiet to vēlreiz."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Resit terlalu besar untuk pelayan. Pendekkan teks dan baca semula."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ပြေစာသည် ဆာဗာအတွက် ကြီးလွန်းသည်။ စာသားကိုအတိုချုံ့၍ ထပ်ဖတ်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvitteringen er for stor for serveren. Forkort teksten og les den på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bon is te groot voor de server. Kort de tekst in en lees deze opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Paragon jest za duży dla serwera. Skróć tekst i odczytaj go ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O recibo é grande demais para o servidor. Reduza o texto e leia-o novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonul este prea mare pentru server. Scurtează textul și citește-l din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чек слишком большой для сервера. Сократите текст и считайте его снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Účtenka je pre server príliš veľká. Skráťte text a znovu ho načítajte."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatura është shumë e madhe për serverin. Shkurto tekstin dhe lexoje përsëri."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Račun je prevelik za server. Skrati tekst i ponovo ga pročitaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvittot är för stort för servern. Korta texten och läs den igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Risiti ni kubwa mno kwa seva. Fupisha maandishi kisha uyasome tena."
