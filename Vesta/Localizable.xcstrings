    "Pair this iPhone with hestia to continue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقرن جهاز iPhone هذا مع hestia للمتابعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালিয়ে যেতে এই iPhone-কে hestia-এর সঙ্গে পেয়ার করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upari ovaj iPhone sa sistemom hestia za nastavak."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro pokračování spárujte tento iPhone se systémem hestia."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan par mellem denne iPhone og hestia for at fortsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopple dieses iPhone mit hestia, um fortzufahren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ζευγοποιήστε αυτό το iPhone με το hestia για να συνεχίσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlaza este iPhone con hestia para continuar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای ادامه، این iPhone را با hestia جفت کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muodosta laitepari tämän iPhonen ja hestia-palvelimen välille jatkaaksesi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-pair ang iPhone na ito sa hestia para magpatuloy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumelez cet iPhone à hestia pour continuer."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Péireáil an iPhone seo le hestia chun leanúint ar aghaidh."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קשר את ה-iPhone הזה ל-hestia כדי להמשיך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखने के लिए इस iPhone को hestia से पेयर करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upari ovaj iPhone sa sustavom hestia za nastavak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A folytatáshoz párosítsd ezt az iPhone készüléket a hestia rendszerrel."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Շարունակելու համար զուգակցեք այս iPhone-ը hestia-ի հետ։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasangkan iPhone ini dengan hestia untuk melanjutkan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Paraðu þennan iPhone við hestia til að halda áfram."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbina questo iPhone a hestia per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けるには、このiPhoneをhestiaとペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하려면 이 iPhone을 hestia와 페어링하십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Norėdami tęsti, susiekite šį iPhone su hestia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai turpinātu, savienojiet šo iPhone pārī ar hestia."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasangkan iPhone ini dengan hestia untuk meneruskan."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဆက်လုပ်ရန် ဤ iPhone ကို hestia နှင့် တွဲချိတ်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble denne iPhonen sammen med hestia for å fortsette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppel deze iPhone met hestia om door te gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparuj tego iPhone’a z hestią, aby kontynuować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Emparelhe este iPhone com o hestia para continuar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Asociază acest iPhone cu hestia pentru a continua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте пару между этим iPhone и hestia, чтобы продолжить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete pokračovať, spárujte tento iPhone so systémom hestia."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çifto këtë iPhone me hestia për të vazhduar."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Upari ovaj iPhone sa sistemom hestia da nastaviš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Parkoppla denna iPhone med hestia för att fortsätta."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Oanisha iPhone hii na hestia ili uendelee."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จับคู่ iPhone เครื่องนี้กับ hestia เพื่อดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam etmek için bu iPhone’u hestia ile eşleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створіть пару між цим iPhone і hestia, щоб продовжити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghép đôi iPhone này với hestia để tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将这部iPhone与hestia配对以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將這部iPhone與hestia配對以繼續。"
          }
        }
      }
    },
