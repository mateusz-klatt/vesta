    "You can add up to 8 receipt photos.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إضافة ما يصل إلى 8 صور للإيصال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রসিদের সর্বোচ্চ ৮টি ছবি যোগ করতে পারেন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete dodati do 8 fotografija računa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete přidat až 8 fotek účtenky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan tilføje op til 8 billeder af kvitteringen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst bis zu 8 Belegfotos hinzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να προσθέσετε έως 8 φωτογραφίες της απόδειξης."
          }
