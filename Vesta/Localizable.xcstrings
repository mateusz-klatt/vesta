    "Pick a different transaction or save the receipt without one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر معاملة مختلفة أو احفظ الإيصال بدونها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য একটি লেনদেন বেছে নিন অথবা লেনদেন ছাড়াই রসিদটি সংরক্ষণ করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi drugu transakciju ili sačuvaj račun bez nje."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte jinou transakci nebo účtenku uložte bez ní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en anden transaktion, eller gem kvitteringen uden en."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine andere Transaktion oder speichere den Beleg ohne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε διαφορετική συναλλαγή ή αποθηκεύστε την απόδειξη χωρίς αυτήν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige otra transacción o guarda el ticket sin ella."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تراکنش دیگری انتخاب کنید یا رسید را بدون آن ذخیره کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse toinen tapahtuma tai tallenna kuitti ilman sitä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng ibang transaksyon o i-save ang resibo nang wala ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une autre transaction ou enregistrez le ticket sans elle."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Roghnaigh idirbheart eile nó sábháil an admháil gan é."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר עסקה אחרת או שמור את הקבלה בלעדיה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई दूसरा लेन-देन चुनें या उसके बिना रसीद सहेजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi drugu transakciju ili spremi račun bez nje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz másik tranzakciót, vagy mentsd a nyugtát anélkül."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրեք այլ գործարք կամ պահպանեք անդորրագիրը առանց դրա:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih transaksi lain atau simpan struk tanpanya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veldu aðra færslu eða vistaðu kvittunina án hennar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un’altra transazione o salva lo scontrino senza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の取引を選択するか、取引なしでレシートを保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 거래를 선택하거나 거래 없이 영수증을 저장하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirinkite kitą operaciją arba išsaugokite kvitą be jos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvēlieties citu darījumu vai saglabājiet čeku bez tā."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih transaksi lain atau simpan resit tanpanya."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အခြားငွေပေးငွေယူတစ်ခုကို ရွေးချယ်ပါ သို့မဟုတ် ငွေပေးငွေယူမပါဘဲ ပြေစာကိုသိမ်းဆည်းပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en annen transaksjon, eller lagre kvitteringen uten en."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een andere transactie of bewaar de bon zonder transactie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz inną transakcję albo zapisz paragon bez niej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha outra transação ou salve o recibo sem ela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege altă tranzacție sau salvează bonul fără una."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите другую операцию или сохраните чек без неё."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte inú transakciu alebo uložte účtenku bez nej."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgjidh një transaksion tjetër ose ruaje faturën pa të."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Izaberi drugu transakciju ili sačuvaj račun bez nje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en annan transaktion eller spara kvittot utan en."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chagua muamala tofauti au hifadhi risiti bila huo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกธุรกรรมอื่นหรือบันทึกใบเสร็จโดยไม่มีธุรกรรม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farklı bir işlem seçin veya fişi işlem olmadan kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть іншу операцію або збережіть чек без неї."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn giao dịch khác hoặc lưu hóa đơn mà không cần giao dịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择其他交易，或不关联交易而保存收据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇其他交易，或不關聯交易而儲存收據。"
          }
        }
      }
    },
