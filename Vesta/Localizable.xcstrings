        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pārāk daudz pierakstīšanās mēģinājumu. Mēģiniet vēlāk."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak percubaan log masuk. Cuba lagi kemudian."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အကောင့်ဝင်ရန် ကြိုးစားမှု များလွန်းသည်။ နောက်မှ ထပ်ကြိုးစားပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange innloggingsforsøk. Prøv igjen senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel inlogpogingen. Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt wiele prób logowania. Spróbuj ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas tentativas de login. Tente de novo mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prea multe încercări de autentificare. Încearcă mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много попыток входа. Повторите попытку позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príliš veľa pokusov o prihlásenie. Skúste to neskôr."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shumë përpjekje për të hyrë. Provo sërish më vonë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Previše pokušaja prijave. Pokušaj ponovo kasnije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För många inloggningsförsök. Försök igen senare."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Umejaribu kuingia mara nyingi sana. Jaribu tena baadaye."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พยายามเข้าสู่ระบบหลายครั้งเกินไป โปรดลองอีกครั้งในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla oturum açma denemesi. Daha sonra tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забагато спроб входу. Спробуйте ще раз пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã thử đăng nhập quá nhiều lần. Hãy thử lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录尝试次数过多。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入嘗試次數過多。請稍後再試。"
          }
        }
