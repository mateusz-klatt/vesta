        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyambung ke hestia. Alih keluar iPhone ini daripada senarai peranti dalam hestia."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "hestia နှင့် ချိတ်ဆက်၍ မရပါ။ hestia ရှိ စက်ပစ္စည်းစာရင်းမှ ဤ iPhone ကို ဖယ်ရှားပါ။"
          }
