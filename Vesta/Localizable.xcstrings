    "Only an admin can view the household budget.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للمسؤول فقط عرض ميزانية المنزل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু প্রশাসক বাড়ির বাজেট দেখতে পারেন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo administrator može vidjeti kućni budžet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpočet domácnosti může zobrazit pouze správce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun en administrator kan se husstandens budget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein Administrator kann das Haushaltsbudget sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο ένας διαχειριστής μπορεί να δει τον προϋπολογισμό του νοικοκυριού."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only an admin can view the household budget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un administrador puede ver el presupuesto del hogar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط مدیر می‌تواند بودجه خانوار را ببیند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain ylläpitäjä voi nähdä kotitalouden budjetin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Admin lang ang makakakita ng badyet ng sambahayan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un administrateur peut consulter le budget du foyer."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní féidir ach le riarthóir buiséad an teaghlaigh a fheiceáil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק מנהל יכול לצפות בתקציב משק הבית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घर का बजट केवल एडमिन देख सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo administrator može vidjeti kućni proračun."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak rendszergazda tekintheti meg a háztartás költségvetését."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միայն ադմինիստրատորը կարող է դիտել տնային բյուջեն։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya admin yang dapat melihat anggaran rumah tangga."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðeins stjórnandi getur skoðað fjárhagsáætlun heimilisins."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un amministratore può vedere il budget familiare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "家計予算を表示できるのは管理者のみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자만 가계 예산을 볼 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik administratorius gali peržiūrėti namų ūkio biudžetą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mājsaimniecības budžetu var skatīt tikai administrators."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pentadbir boleh melihat belanjawan isi rumah."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အိမ်ထောင်စုဘတ်ဂျက်ကို အက်ဒမင်သာ ကြည့်နိုင်ပါသည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare en administrator kan se husholdningens budsjett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen een beheerder kan het huishoudbudget bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko administrator może wyświetlić budżet gospodarstwa domowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente um administrador pode ver o orçamento da casa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar un administrator poate vedea bugetul gospodăriei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только администратор может просматривать бюджет домохозяйства."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpočet domácnosti môže zobraziť iba správca."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetëm një administrator mund të shohë buxhetin e familjes."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo administrator može da vidi budžet domaćinstva."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast en administratör kan se hushållets budget."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni msimamizi pekee anayeweza kuona bajeti ya kaya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะผู้ดูแลระบบเท่านั้นที่ดูงบประมาณของครัวเรือนได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hane bütçesini yalnızca yönetici görebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише адміністратор може переглядати бюджет домогосподарства."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ quản trị viên mới có thể xem ngân sách hộ gia đình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有管理员可以查看家庭预算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有管理員可以查看家庭預算。"
          }
        }
      }
    },
