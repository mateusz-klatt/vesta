    "No budget configured for this month.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُحدد ميزانية لهذا الشهر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মাসের বাজেট নির্ধারণ করা হয়নি।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ovaj mjesec nije postavljen budžet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tento měsíc není nastaven rozpočet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ikke angivet et budget for denne måned."
          }
        },
        "de": {
          "stringUnit": {
