    "Fix anything misread, then send it to your server to read the receipt.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صحّح أي أجزاء قُرئت بشكل خاطئ، ثم أرسل النص إلى خادمك لقراءة الإيصال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভুল পড়া অংশ ঠিক করুন, তারপর রসিদটি পড়ার জন্য লেখাটি আপনার সার্ভারে পাঠান।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispravi sve pogrešno pročitano, zatim pošalji tekst na svoj server da pročita račun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravte všechny chybně přečtené části a potom text odešlete na svůj server, aby účtenku přečetl."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ret alt, der er læst forkert, og send derefter teksten til din server, så den kan læse kvitteringen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigiere falsch erkannte Stellen und sende den Text anschließend an deinen Server, um den Beleg auszulesen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διορθώστε ό,τι διαβάστηκε λάθος και στείλτε το κείμενο στον διακομιστή σας για να διαβάσει την απόδειξη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige cualquier error de lectura y envía el texto a tu servidor para que lea el ticket."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر بخشی که اشتباه خوانده شده را اصلاح کنید، سپس متن را برای خواندن رسید به سرور خود بفرستید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korjaa virheellisesti luetut kohdat ja lähetä teksti sitten palvelimellesi kuitin lukemista varten."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itama ang anumang maling nabasa, pagkatapos ay ipadala ang teksto sa iyong server para basahin ang resibo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrigez les passages mal reconnus, puis envoyez le texte à votre serveur pour qu’il lise le ticket."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceartaigh aon rud a léadh go mícheart, ansin seol an téacs chuig do fhreastalaí chun an admháil a léamh."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תקן כל דבר שנקרא באופן שגוי, ולאחר מכן שלח את הטקסט לשרת שלך כדי שיקרא את הקבלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गलत पढ़ी गई किसी भी चीज़ को ठीक करें, फिर रसीद पढ़ने के लिए टेक्स्ट को अपने सर्वर पर भेजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispravi sve pogrešno pročitano, zatim pošalji tekst na svoj poslužitelj da pročita račun."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Javítsd ki a tévesen felismert részeket, majd küldd el a szöveget a szerveredre a nyugta beolvasásához."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ուղղեք սխալ կարդացված մասերը, ապա տեքստը ուղարկեք ձեր սերվերին՝ անդորրագիրը կարդալու համար:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbaiki bagian yang salah dibaca, lalu kirim teks ke server Anda untuk membaca struk."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagaðu allt sem var rangt lesið og sendu síðan textann á þjóninn þinn til að lesa kvittunina."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Correggi gli errori di lettura, poi invia il testo al tuo server per leggere lo scontrino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り誤りを修正してから、テキストをサーバーに送信してレシートを読み取らせてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘못 인식된 부분을 수정한 후 서버로 텍스트를 보내 영수증을 읽게 하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pataisykite neteisingai perskaitytas vietas, tada išsiųskite tekstą į savo serverį kvitui perskaityti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izlabojiet visas nepareizi nolasītās vietas, pēc tam nosūtiet tekstu uz savu serveri čeka nolasīšanai."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Betulkan apa sahaja yang salah dibaca, kemudian hantar teks itu ke pelayan anda untuk membaca resit."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "မှားယွင်းဖတ်ရှုမိသည့်အပိုင်းများကို ပြင်ဆင်ပြီး ပြေစာကိုဖတ်ရန် စာသားကို သင့်ဆာဗာသို့ ပေးပို့ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rett alt som er feil lest, og send deretter teksten til serveren din for å lese kvitteringen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrigeer alles wat verkeerd is gelezen en stuur de tekst daarna naar je server om de bon te lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Popraw źle odczytane fragmenty, a potem wyślij tekst na serwer, żeby odczytał paragon."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrija qualquer erro de leitura e envie o texto ao seu servidor para ler o recibo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Corectează orice a fost citit greșit, apoi trimite textul pe serverul tău pentru a citi bonul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исправьте ошибки распознавания, затем отправьте текст на свой сервер, чтобы он обработал чек."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravte všetko nesprávne prečítané a potom odošlite text na svoj server, aby prečítal účtenku."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigjo çdo gjë që është lexuar gabim, pastaj dërgo tekstin në serverin tënd për të lexuar faturën."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispravi sve pogrešno pročitano, zatim pošalji tekst na svoj server da pročita račun."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rätta allt som har lästs fel och skicka sedan texten till din server för att läsa kvittot."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahihisha chochote kilichosomwa vibaya, kisha tuma maandishi kwa seva yako ili isome risiti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขส่วนที่อ่านผิด แล้วส่งข้อความไปยังเซิร์ฟเวอร์ของคุณเพื่ออ่านใบเสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanlış okunan yerleri düzeltin, ardından fişi okuması için metni sunucunuza gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виправте неправильно розпізнані фрагменти, а потім надішліть текст на свій сервер, щоб він прочитав чек."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sửa mọi phần bị đọc sai, rồi gửi văn bản đến máy chủ của bạn để đọc hóa đơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修正所有识别错误，然后将文本发送到你的服务器以读取收据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修正所有辨識錯誤，然後將文字傳送到你的伺服器以讀取收據。"
          }
        }
      }
    },
    "Fix the receipt text so the item totals add up to the total, then read it again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صحّح نص الإيصال بحيث يكون مجموع مبالغ العناصر مساويًا للإجمالي، ثم اقرأه مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রসিদের লেখা ঠিক করুন যাতে আইটেমগুলির মোট যোগফল সর্বমোটের সঙ্গে মেলে, তারপর আবার পড়ুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispravi tekst računa tako da zbir iznosa stavki odgovara ukupnom iznosu, zatim ga ponovno pročitaj."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravte text účtenky tak, aby součet částek položek odpovídal celkové částce, a poté ji přečtěte znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ret kvitteringsteksten, så summen af varerne svarer til totalen, og læs den derefter igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigiere den Belegtext, damit die Summe der Posten dem Gesamtbetrag entspricht, und lies ihn dann erneut ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διορθώστε το κείμενο της απόδειξης ώστε το άθροισμα των ειδών να συμφωνεί με το σύνολο και διαβάστε το ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige el texto del ticket para que el importe de los artículos coincida con el total y léelo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "متن رسید را طوری اصلاح کنید که مجموع مبالغ اقلام با مبلغ کل برابر شود، سپس آن را دوباره بخوانید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korjaa kuitin tekstiä niin, että tuotteiden summat täsmäävät loppusummaan, ja lue se sitten uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayusin ang teksto ng resibo para tumugma ang kabuuan ng mga item sa kabuuang halaga, pagkatapos ay basahin itong muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrigez le texte du ticket pour que la somme des articles corresponde au total, puis relisez-le."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceartaigh téacs na hadmhála chun go mbeidh suim na n-earraí cothrom leis an iomlán, ansin léigh arís é."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תקן את טקסט הקבלה כך שסכום הפריטים יהיה שווה לסכום הכולל, ולאחר מכן קרא אותו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रसीद का टेक्स्ट ठीक करें ताकि आइटम की रकम का योग कुल योग के बराबर हो, फिर इसे दोबारा पढ़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispravi tekst računa tako da zbroj iznosa stavki odgovara ukupnom iznosu, zatim ga ponovno pročitaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Javítsd ki a nyugta szövegét úgy, hogy a tételek összege egyezzen a végösszeggel, majd olvasd be újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ուղղեք անդորրագրի տեքստը այնպես, որ ապրանքների գումարների հանրագումարը համապատասխանի ընդհանուրին, ապա կրկին կարդացեք այն:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbaiki teks struk agar jumlah nominal item sesuai dengan total, lalu baca lagi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagaðu texta kvittunarinnar þannig að summur vöruliða samrýmist heildarupphæðinni og lestu hann síðan aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Correggi il testo dello scontrino in modo che la somma degli articoli corrisponda al totale, poi leggilo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目の合計がレシートの合計金額と一致するようにテキストを修正してから、もう一度読み取ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목 금액의 합계가 전체 합계와 일치하도록 영수증 텍스트를 수정한 후 다시 읽으세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pataisykite kvito tekstą taip, kad prekių sumų bendra suma sutaptų su galutine suma, ir perskaitykite jį dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izlabojiet čeka tekstu tā, lai preču summu kopsumma atbilstu kopējai summai, un nolasiet to vēlreiz."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Betulkan teks resit supaya jumlah amaun item sepadan dengan jumlah keseluruhan, kemudian bacanya sekali lagi."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ပစ္စည်းအလိုက်ငွေပမာဏများ၏စုစုပေါင်းသည် စုစုပေါင်းငွေနှင့်ကိုက်ညီစေရန် ပြေစာစာသားကိုပြင်ဆင်ပြီး ထပ်ဖတ်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rett kvitteringsteksten slik at summen av varene tilsvarer totalsummen, og les den deretter på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrigeer de bontekst zodat de bedragen van de artikelen overeenkomen met het totaal en lees de bon opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Popraw tekst paragonu tak, żeby kwoty pozycji sumowały się do sumy, i odczytaj go ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrija o texto do recibo para que a soma dos itens corresponda ao total e leia-o novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Corectează textul bonului astfel încât suma articolelor să corespundă totalului, apoi citește-l din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исправьте текст чека так, чтобы сумма позиций совпадала с итоговой суммой, затем обработайте его ещё раз."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opravte text účtenky tak, aby súčet čiastok položiek zodpovedal celkovej sume, a potom ju prečítajte znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigjo tekstin e faturës në mënyrë që shuma e artikujve të përputhet me totalin, pastaj lexoje sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispravi tekst računa tako da zbir iznosa stavki odgovara ukupnom iznosu, zatim ga ponovo pročitaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigera kvittotexten så att summan av posterna stämmer med totalsumman och läs den sedan igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahihisha maandishi ya risiti ili jumla ya vipengee iendane na jumla kuu, kisha yasome tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขข้อความใบเสร็จให้ยอดรวมของรายการตรงกับยอดรวมทั้งหมด แล้วอ่านอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalemlerin toplamı genel toplama eşit olacak şekilde fiş metnini düzeltin, ardından yeniden okuyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виправте текст чека так, щоб сума позицій дорівнювала загальній сумі, а потім прочитайте його ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sửa văn bản hóa đơn để tổng các mặt hàng khớp với tổng cộng, rồi đọc lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请修正收据文本，使各项目金额之和等于总金额，然后重新读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請修正收據文字，使各項目金額總和等於總金額，然後重新讀取。"
          }
        }
      }
    },
