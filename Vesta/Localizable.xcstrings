    "No matching transaction yet. You can save the receipt without one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد معاملة مطابقة بعد. يمكنك حفظ الإيصال بدونها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কোনো মিলে যাওয়া লেনদেন নেই। লেনদেন ছাড়াই রসিদটি সংরক্ষণ করতে পারেন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema odgovarajuće transakcije. Račun možeš sačuvati bez nje."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím neexistuje odpovídající transakce. Účtenku můžete uložit i bez ní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er endnu ingen matchende transaktion. Du kan gemme kvitteringen uden en."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine passende Transaktion. Du kannst den Beleg auch ohne speichern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει ακόμη αντίστοιχη συναλλαγή. Μπορείτε να αποθηκεύσετε την απόδειξη χωρίς αυτήν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay ninguna transacción coincidente. Puedes guardar el ticket sin ella."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز تراکنش منطبقی وجود ندارد. می‌توانید رسید را بدون آن ذخیره کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastaavaa tapahtumaa ei vielä ole. Voit tallentaa kuitin ilman sitä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang tumutugmang transaksyon. Maaari mong i-save ang resibo nang wala ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune transaction correspondante pour le moment. Vous pouvez enregistrer le ticket sans elle."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl aon idirbheart meaitseála ann go fóil. Is féidir leat an admháil a shábháil gan é."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין עסקה תואמת. אפשר לשמור את הקבלה בלעדיה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई मेल खाता लेन-देन नहीं है। आप उसके बिना रसीद सहेज सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema odgovarajuće transakcije. Račun možeš spremiti bez nje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs megfelelő tranzakció. A nyugta enélkül is menthető."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Համապատասխան գործարք դեռ չկա: Դուք կարող եք պահպանել անդորրագիրը առանց դրա:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada transaksi yang cocok. Anda dapat menyimpan struk tanpanya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engin samsvarandi færsla er enn til. Þú getur vistað kvittunina án hennar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna transazione corrispondente per ora. Puoi salvare lo scontrino senza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致する取引がまだありません。取引なしでレシートを保存できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 일치하는 거래가 없습니다. 거래 없이 영수증을 저장할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atitinkančios operacijos dar nėra. Kvitą galite išsaugoti ir be jos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atbilstoša darījuma vēl nav. Čeku varat saglabāt bez tā."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada transaksi yang sepadan. Anda boleh menyimpan resit tanpanya."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ကိုက်ညီသော ငွေပေးငွေယူ မရှိသေးပါ။ ငွေပေးငွေယူမပါဘဲ ပြေစာကိုသိမ်းဆည်းနိုင်သည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen samsvarende transaksjon ennå. Du kan lagre kvitteringen uten en."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen overeenkomende transactie. Je kunt de bon zonder transactie bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak pasującej transakcji. Możesz zapisać paragon bez niej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há transação correspondente. Você pode salvar o recibo sem ela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există încă o tranzacție potrivită. Poți salva bonul fără una."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходящей операции пока нет. Вы можете сохранить чек без неё."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ neexistuje zodpovedajúca transakcia. Účtenku môžete uložiť aj bez nej."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ende nuk ka transaksion që përputhet. Mund ta ruash faturën pa të."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
