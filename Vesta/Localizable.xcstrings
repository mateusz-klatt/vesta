    "In hestia, choose Add device to get a one-time pairing code.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في hestia، اختر إضافة جهاز للحصول على رمز اقتران يُستخدم مرة واحدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একবার ব্যবহারযোগ্য পেয়ারিং কোড পেতে hestia-তে ডিভাইস যোগ করুন বেছে নিন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "U sistemu hestia odaberi Dodaj uređaj da dobiješ jednokratni kod za uparivanje."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V systému hestia vyberte Přidat zařízení a získejte jednorázový párovací kód."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg Tilføj enhed i hestia for at få en engangskode til pardannelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle in hestia Gerät hinzufügen, um einen einmaligen Kopplungscode zu erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο hestia, επιλέξτε Προσθήκη συσκευής για να λάβετε έναν κωδικό ζευγοποίησης μίας χρήσης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En hestia, elige Añadir dispositivo para obtener un código de enlace de un solo uso."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در hestia، افزودن دستگاه را انتخاب کنید تا کد جفت‌سازی یک‌بارمصرف بگیرید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse hestia-palvelussa Lisää laite saadaksesi kertakäyttöisen laiteparikoodin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa hestia, piliin ang Magdagdag ng device para makakuha ng code sa pagpapares na isang beses lang magagamit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans hestia, choisissez Ajouter un appareil pour obtenir un code de jumelage à usage unique."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "I hestia, roghnaigh Cuir gléas leis chun cód péireála aonuaire a fháil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב-hestia, בחר הוספת מכשיר לקבלת קוד קישור חד-פעמי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार इस्तेमाल होने वाला पेयरिंग कोड पाने के लिए hestia में डिवाइस जोड़ें चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U sustavu hestia odaberi Dodaj uređaj da dobiješ jednokratni kod za uparivanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hestia rendszerben válaszd az Eszköz hozzáadása lehetőséget az egyszer használatos párosítási kódhoz."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "hestia-ում ընտրեք Ավելացնել սարք՝ զուգակցման մեկանգամյա կոդ ստանալու համար։"
          }
        },
        "id": {
          "stringUnit": {
