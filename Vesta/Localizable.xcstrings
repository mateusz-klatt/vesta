    "Some events are not shown because the result was truncated.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تظهر بعض الأحداث لأن النتائج اقتُطعت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফলাফল সীমিত হওয়ায় কিছু ইভেন্ট দেখানো হচ্ছে না।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neki događaji nisu prikazani jer je rezultat skraćen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Některé události se nezobrazují, protože výsledek byl zkrácen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle begivenheder vises ikke, fordi resultatet er afkortet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Termine werden nicht angezeigt, da das Ergebnis gekürzt wurde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορισμένα συμβάντα δεν εμφανίζονται επειδή τα αποτελέσματα περικόπηκαν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some events are not shown because the result was truncated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos eventos no se muestran porque el resultado se ha truncado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برخی رویدادها به‌دلیل کوتاه شدن نتایج نمایش داده نمی‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osa tapahtumista ei näy, koska tulos on katkaistu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ipinapakita ang ilang event dahil pinaikli ang mga resulta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains événements ne sont pas affichés, car les résultats ont été tronqués."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní thaispeántar roinnt imeachtaí mar gur giorraíodh na torthaí."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלק מהאירועים אינם מוצגים כי רשימת התוצאות נקטעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नतीजों की सूची छोटी की गई है, इसलिए कुछ इवेंट नहीं दिखाए गए हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neki događaji nisu prikazani jer je rezultat skraćen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyes események nem jelennek meg, mert a találati lista csonkolva lett."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Որոշ իրադարձություններ չեն ցուցադրվում, քանի որ արդյունքը կրճատվել է։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa acara tidak ditampilkan karena hasilnya terpotong."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumir viðburðir birtast ekki þar sem niðurstöðurnar voru styttar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni eventi non vengono mostrati perché il risultato è stato troncato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果が一部省略されたため、表示されていない予定があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과가 잘려 일부 일정이 표시되지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kai kurie įvykiai nerodomi, nes rezultatai sutrumpinti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Daži notikumi netiek rādīti, jo rezultāti ir saīsināti."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai hasil dipendekkan, jadi sesetengah acara tidak dipaparkan."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ရလဒ်စာရင်းကို အတိုချုံ့ထားသောကြောင့် အစီအစဉ်အချို့ကို မပြသပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen hendelser vises ikke fordi resultatet er avkortet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige afspraken worden niet weergegeven omdat het resultaat is ingekort."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre wydarzenia nie są widoczne, ponieważ lista wyników została skrócona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns eventos não são exibidos porque o resultado foi truncado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unele evenimente nu sunt afișate deoarece rezultatul a fost trunchiat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые события не показаны, так как список результатов был сокращён."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektoré udalosti sa nezobrazujú, pretože výsledky boli skrátené."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Disa ngjarje nuk shfaqen sepse lista e rezultateve u shkurtua."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Neki događaji nisu prikazani jer je lista rezultata skraćena."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa händelser visas inte eftersom resultatet har kortats ned."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Baadhi ya matukio hayaonyeshwi kwa sababu orodha ya matokeo imefupishwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บางกิจกรรมไม่แสดงเนื่องจากผลลัพธ์ถูกตัดให้สั้นลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonuç listesi kısaltıldığı için bazı etkinlikler gösterilmiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі події не показано, оскільки список результатів скорочено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số sự kiện không được hiển thị vì kết quả đã bị cắt bớt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果已被截断，因此未显示部分活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果已截斷，因此部分活動未顯示。"
          }
        }
      }
    },
    "Some item amounts don’t add up. Go back and fix the text.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك خطأ في جمع مبالغ بعض العناصر. ارجع وصحح النص."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু আইটেমের মূল্যের হিসাব মিলছে না। ফিরে গিয়ে টেক্সটটি ঠিক করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Iznosi nekih stavki se ne slažu. Vrati se i ispravi tekst."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Částky některých položek nesedí. Vraťte se a opravte text."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beløbene på nogle varer stemmer ikke. Gå tilbage og ret teksten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beträge einzelner Posten passen nicht zusammen. Gehe zurück und korrigiere den Text."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ποσά ορισμένων ειδών δεν βγαίνουν. Επιστρέψτε και διορθώστε το κείμενο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los importes de algunos artículos no cuadran. Vuelve atrás y corrige el texto."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مبلغ برخی اقلام درست جمع نمی‌شود. برگردید و متن را اصلاح کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Joidenkin tuotteiden summat eivät täsmää. Palaa takaisin ja korjaa teksti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi tumutugma ang ilang halaga ng item. Bumalik at itama ang text."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les montants de certains articles ne concordent pas. Revenez en arrière et corrigez le texte."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Níl suimeanna roinnt míreanna ag teacht le chéile. Téigh ar ais agus ceartaigh an téacs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסכומים של חלק מהפריטים לא מסתדרים. חזור ותקן את הטקסט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ आइटम की राशियों का हिसाब नहीं मिल रहा है। वापस जाकर टेक्स्ट ठीक करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Iznosi nekih stavki se ne slažu. Vrati se i ispravi tekst."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyes tételek összegei nem stimmelnek. Menj vissza, és javítsd ki a szöveget."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Որոշ ապրանքների գումարները չեն համընկնում։ Վերադարձեք և ուղղեք տեքստը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah beberapa item tidak cocok. Kembali dan perbaiki teks."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Upphæðir sumra vara stemma ekki. Farðu til baka og leiðréttu textann."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli importi di alcuni articoli non tornano. Torna indietro e correggi il testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の項目の金額が合いません。戻ってテキストを修正してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 항목의 금액이 맞지 않습니다. 돌아가서 텍스트를 수정하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kai kurių prekių sumos nesutampa. Grįžkite ir pataisykite tekstą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dažu preču summas nesakrīt. Dodieties atpakaļ un labojiet tekstu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah beberapa item tidak sepadan. Kembali dan betulkan teks."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အချို့ပစ္စည်းများ၏ ငွေပမာဏများ မကိုက်ညီပါ။ နောက်သို့ပြန်သွား၍ စာသားကို ပြင်ဆင်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beløpene for noen varer stemmer ikke. Gå tilbake og rett teksten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bedragen van sommige artikelen kloppen niet. Ga terug en corrigeer de tekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwoty niektórych pozycji się nie zgadzają. Wróć i popraw tekst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores de alguns itens não batem. Volte e corrija o texto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumele unor articole nu se potrivesc. Mergi înapoi și corectează textul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Суммы некоторых позиций не сходятся. Вернитесь назад и исправьте текст."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumy niektorých položiek nesedia. Vráťte sa a opravte text."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shumat e disa artikujve nuk përputhen. Kthehu prapa dhe korrigjo tekstin."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Iznosi nekih stavki se ne slažu. Vrati se i ispravi tekst."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beloppen för vissa artiklar stämmer inte. Gå tillbaka och korrigera texten."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiasi cha baadhi ya vipengee hakilingani. Rudi nyuma na sahihisha maandishi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนเงินของบางรายการรวมกันไม่ถูกต้อง กลับไปแก้ไขข้อความ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı ürünlerin tutarları toplamla uyuşmuyor. Geri dönün ve metni düzeltin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Суми деяких позицій не сходяться. Поверніться і виправте текст."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số tiền của một số mục không khớp. Quay lại và sửa văn bản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分项目的金额对不上。请返回并修正文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分項目的金額對不上。請返回並修正文字。"
          }
        }
      }
