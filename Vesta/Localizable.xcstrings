{
  "sourceLanguage": "en",
  "strings": {
    "Choose another photo, scan again, or paste the receipt text.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر صورة أخرى، أو أعد المسح، أو الصق نص الإيصال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য একটি ছবি বেছে নিন, আবার স্ক্যান করুন, অথবা রসিদের লেখা পেস্ট করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite drugu fotografiju, ponovo skenirajte ili zalijepite tekst računa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte jinou fotku, znovu naskenujte účtenku nebo vložte její text."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et andet foto, scan igen, eller indsæt kvitteringsteksten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein anderes Foto, scanne erneut oder füge den Belegtext ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε άλλη φωτογραφία, σαρώστε ξανά ή επικολλήστε το κείμενο της απόδειξης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose another photo, scan again, or paste the receipt text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige otra foto, vuelve a escanear o pega el texto del recibo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عکس دیگری انتخاب کنید، دوباره اسکن کنید یا متن رسید را جای‌گذاری کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse toinen kuva, skannaa uudelleen tai liitä kuitin teksti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng ibang larawan, mag-scan ulit, o i-paste ang teksto ng resibo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une autre photo, scannez à nouveau ou collez le texte du reçu."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Roghnaigh grianghraf eile, scan arís nó greamaigh téacs an admhála."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו תמונה אחרת, סרקו שוב או הדביקו את טקסט הקבלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरी फ़ोटो चुनें, फिर से स्कैन करें या रसीद का टेक्स्ट पेस्ट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite drugu fotografiju, ponovno skenirajte ili zalijepite tekst računa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon másik fotót, olvassa be újra a nyugtát, vagy illessze be a szövegét."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրեք այլ լուսանկար, կրկին սկանավորեք կամ տեղադրեք կտրոնի տեքստը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih foto lain, pindai lagi, atau tempel teks struk."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veldu aðra mynd, skannaðu aftur eða límdu texta kvittunarinnar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un’altra foto, scansiona di nuovo o incolla il testo dello scontrino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の写真を選ぶか、もう一度スキャンするか、レシートのテキストを貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사진을 선택하거나 다시 스캔하거나 영수증 텍스트를 붙여 넣으세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirinkite kitą nuotrauką, nuskaitykite iš naujo arba įklijuokite kvito tekstą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvēlieties citu fotoattēlu, skenējiet vēlreiz vai ielīmējiet čeka tekstu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih foto lain, imbas semula atau tampal teks resit."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အခြားဓာတ်ပုံကို ရွေးပါ၊ ပြန်စကင်ဖတ်ပါ သို့မဟုတ် ပြေစာစာသားကို ကူးထည့်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et annet bilde, skann på nytt, eller lim inn kvitteringsteksten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een andere foto, scan opnieuw of plak de tekst van de bon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz inne zdjęcie, zeskanuj ponownie lub wklej tekst paragonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha outra foto, digitalize novamente ou cole o texto do recibo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege altă fotografie, scanează din nou sau lipește textul bonului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите другое фото, отсканируйте ещё раз или вставьте текст чека."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte inú fotku, znova naskenujte bloček alebo vložte jeho text."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgjidhni një foto tjetër, skanoni sërish ose ngjitni tekstin e kuponit."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Izaberite drugu fotografiju, ponovo skenirajte ili nalepite tekst računa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett annat foto, skanna igen eller klistra in kvittotexten."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chagua picha nyingine, changanua tena, au bandika maandishi ya risiti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกรูปอื่น สแกนอีกครั้ง หรือวางข้อความใบเสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir fotoğraf seçin, yeniden tarayın veya fiş metnini yapıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть інше фото, відскануйте ще раз або вставте текст чека."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ảnh khác, quét lại hoặc dán văn bản biên lai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择其他照片、重新扫描，或粘贴收据文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇其他照片、重新掃描，或貼上收據文字。"
          }
        }
      }
    },
