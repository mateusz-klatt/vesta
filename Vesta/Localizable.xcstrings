        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ပြေစာပါ ပစ္စည်းစာရင်းကို အသုံးမပြုနိုင်ခဲ့ပါ။ ပြေစာကို စုစုပေါင်းငွေပမာဏအရ အတည်ပြုပါမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Postene kunne ikke brukes — kvitteringen bekreftes ut fra totalbeløpet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De artikelen konden niet worden gebruikt — de bon wordt bevestigd op basis van het totaalbedrag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
