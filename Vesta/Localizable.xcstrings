    "The server received more than one credential. Check your connection and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلقى الخادم أكثر من مجموعة من بيانات الاعتماد. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সার্ভার একাধিক প্রমাণীকরণ তথ্য পেয়েছে। আপনার সংযোগ যাচাই করে আবার চেষ্টা করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server je primio više od jedne vjerodajnice. Provjeri vezu i pokušaj ponovo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server obdržel více než jednu sadu přihlašovacích údajů. Zkontrolujte připojení a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren modtog mere end ét sæt legitimationsoplysninger. Kontrollér forbindelsen, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat mehr als einen Satz Anmeldedaten erhalten. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής έλαβε περισσότερα από ένα σύνολα διαπιστευτηρίων. Ελέγξτε τη σύνδεσή σας και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor ha recibido más de una credencial. Comprueba la conexión e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرور بیش از یک مجموعه اطلاعات احراز هویت دریافت کرد. اتصال خود را بررسی کنید و دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin vastaanotti useamman kuin yhden tunnistetietojoukon. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakatanggap ang server ng higit sa isang kredensyal. Suriin ang iyong koneksyon at subukan ulit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a reçu plusieurs identifiants. Vérifiez votre connexion et réessayez."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuair an freastalaí níos mó ná tacar amháin dintiúr. Seiceáil do cheangal agus bain triail eile as."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השרת קיבל יותר מקבוצה אחת של פרטי אימות. בדוק את החיבור ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर को एक से अधिक क्रेडेंशियल मिले। अपना कनेक्शन जाँचें और फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslužitelj je primio više od jedne vjerodajnice. Provjeri vezu i pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver egynél több hitelesítő adatot kapott. Ellenőrizd a kapcsolatot, és próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սերվերը ստացել է նույնականացման տվյալների մեկից ավելի հավաքածու։ Ստուգեք կապը և կրկին փորձեք։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server menerima lebih dari satu kredensial. Periksa koneksi Anda dan coba lagi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þjónninn fékk fleiri en eitt auðkenni. Athugaðu tenginguna og reyndu aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha ricevuto più di una credenziale. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが複数の認証情報を受信しました。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에서 둘 이상의 인증 정보를 받았습니다. 연결을 확인하고 다시 시도하십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveris gavo daugiau nei vieną prisijungimo duomenų rinkinį. Patikrinkite ryšį ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveris saņēma vairāk nekā vienu akreditācijas datu kopu. Pārbaudiet savienojumu un mēģiniet vēlreiz."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelayan menerima lebih daripada satu kelayakan. Semak sambungan anda dan cuba lagi."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဆာဗာသည် အထောက်အထား အချက်အလက် တစ်ခုထက်ပို၍ လက်ခံရရှိခဲ့သည်။ သင့်ချိတ်ဆက်မှုကို စစ်ဆေးပြီး ထပ်မံကြိုးစားပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren mottok mer enn ett sett med påloggingsopplysninger. Kontroller tilkoblingen og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server heeft meer dan één set inloggegevens ontvangen. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer otrzymał więcej niż jeden zestaw danych uwierzytelniających. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor recebeu mais de uma credencial. Verifique a conexão e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverul a primit mai mult de un set de date de autentificare. Verifică conexiunea și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер получил несколько наборов учётных данных. Проверьте подключение и повторите попытку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Server dostal viac ako jednu súpravu prihlasovacích údajov. Skontrolujte pripojenie a skúste to znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveri mori më shumë se një grup kredencialesh. Kontrollo lidhjen dhe provo përsëri."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Server je primio više od jednog skupa podataka za autentifikaciju. Proveri vezu i pokušaj ponovo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servern tog emot mer än en uppsättning autentiseringsuppgifter. Kontrollera anslutningen och försök igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Seva imepokea zaidi ya seti moja ya taarifa za uthibitishaji. Angalia muunganisho wako na ujaribu tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ได้รับข้อมูลประจำตัวมากกว่าหนึ่งรายการ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu birden fazla kimlik bilgisi aldı. Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер отримав кілька наборів облікових даних. Перевірте з’єднання й повторіть спробу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ nhận được nhiều hơn một thông tin xác thực. Kiểm tra kết nối của bạn rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器收到了多个凭据。请检查连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器收到了多個憑證。請檢查連線後再試一次。"
          }
        }
      }
    },
    "This isn’t a hestia pairing QR code.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ليس رمز QR للاقتران مع hestia."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি hestia-এর পেয়ারিং QR কোড নয়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo nije QR kod za uparivanje sa sistemom hestia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto není QR kód pro párování se systémem hestia."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er ikke en QR-kode til pardannelse med hestia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist kein QR-Code zum Koppeln mit hestia."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός δεν είναι κωδικός QR ζευγοποίησης του hestia."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este no es un código QR de enlace de hestia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کد QR برای جفت‌سازی با hestia نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä ei ole hestia-palvelimen laiteparin QR-koodi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ito QR code para sa pagpapares sa hestia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas un code QR de jumelage hestia."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní cód QR péireála hestia é seo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה אינו קוד QR לקישור עם hestia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह hestia का पेयरिंग QR कोड नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
