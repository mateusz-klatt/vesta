    "Confirm or discard some drafts on the server, then try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكّد بعض المسودات على الخادم أو احذفها، ثم حاول مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সার্ভারের কিছু খসড়া নিশ্চিত বা বাতিল করুন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrdi ili odbaci neke nacrte na serveru, pa pokušaj ponovno."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrďte nebo zahoďte některé koncepty na serveru a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekræft eller kasser nogle kladder på serveren, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige oder verwirf einige Entwürfe auf dem Server und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιβεβαιώστε ή απορρίψτε ορισμένα πρόχειρα στον διακομιστή και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma o descarta algunos borradores en el servidor y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برخی پیش‌نویس‌ها را روی سرور تأیید یا رد کنید، سپس دوباره تلاش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahvista tai hylkää joitakin luonnoksia palvelimella ja yritä uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumpirmahin o tanggalin ang ilang draft sa server, pagkatapos ay subukang muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez ou supprimez certains brouillons sur le serveur, puis réessayez."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Deimhnigh nó scrios roinnt dréachtaí ar an bhfreastalaí, agus déan iarracht arís."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אשר או מחק חלק מהטיוטות בשרת, ולאחר מכן נסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर पर कुछ ड्राफ़्ट की पुष्टि करें या उन्हें छोड़ दें, फिर दोबारा कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrdi ili odbaci neke skice na poslužitelju, pa pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagyj jóvá vagy vess el néhány piszkozatot a szerveren, majd próbáld újra."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաստատեք կամ մերժեք որոշ սևագրեր սերվերում, ապա կրկին փորձեք:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfirmasi atau buang beberapa draf di server, lalu coba lagi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Staðfestu eða fleygðu nokkrum drögum á þjóninum og reyndu síðan aftur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma o scarta alcune bozze sul server, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー上の下書きをいくつか確定または破棄してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버의 일부 초안을 승인하거나 폐기한 후 다시 시도하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Patvirtinkite arba atmeskite kai kuriuos juodraščius serveryje, tada bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apstipriniet vai izmetiet dažus melnrakstus serverī un mēģiniet vēlreiz."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahkan atau buang beberapa draf di pelayan, kemudian cuba lagi."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဆာဗာရှိ မူကြမ်းအချို့ကို အတည်ပြုရန် သို့မဟုတ် ပယ်ဖျောက်ရန် ပြုလုပ်ပြီး ထပ်ကြိုးစားပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekreft eller forkast noen utkast på serveren, og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig of verwerp enkele concepten op de server en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatwierdź lub odrzuć część szkiców na serwerze i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme ou descarte alguns rascunhos no servidor e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmă sau renunță la câteva ciorne de pe server, apoi încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите или отклоните некоторые черновики на сервере и повторите попытку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrďte alebo zahoďte niektoré koncepty na serveri a skúste to znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfirmo ose refuzo disa skica në server, pastaj provo sërish."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrdi ili odbaci neke nacrte na serveru, pa pokušaj ponovo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekräfta eller kassera några utkast på servern och försök igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Thibitisha au futa baadhi ya rasimu kwenye seva, kisha jaribu tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันหรือละทิ้งฉบับร่างบางรายการบนเซิร์ฟเวอร์ แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucudaki bazı taslakları onaylayın veya atın, ardından yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтвердьте або відхиліть кілька чернеток на сервері, потім повторіть спробу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác nhận hoặc bỏ một số bản nháp trên máy chủ, rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认或丢弃服务器上的一些草稿，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認或捨棄伺服器上的一些草稿，然後再試一次。"
          }
        }
      }
    },
