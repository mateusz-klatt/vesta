          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chevauchement des photos a été estimé. Vérifiez les lignes du reçu avant de confirmer."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinneadh meastachán ar fhorluí na ngrianghraf. Seiceáil línte na hadmhála sula ndeimhníonn tú."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
