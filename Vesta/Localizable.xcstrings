    "The server could not accept this receipt.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على الخادم قبول هذا الإيصال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সার্ভার এই রসিদটি গ্রহণ করতে পারেনি।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server nije mogao prihvatiti ovaj račun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server nemohl tuto účtenku přijmout."
