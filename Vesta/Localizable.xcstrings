    "Items and total differ by %@. Go back and fix the text.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تختلف العناصر عن الإجمالي بمقدار %@. ارجع وصحّح النص."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আইটেম ও সর্বমোটের মধ্যে %@ পার্থক্য রয়েছে। ফিরে গিয়ে লেখা ঠিক করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavke i ukupan iznos razlikuju se za %@. Vrati se i ispravi tekst."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky a celková částka se liší o %@. Vraťte se a opravte text."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Varerne og totalen adskiller sig med %@. Gå tilbage og ret teksten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Posten und Gesamtbetrag weichen um %@ voneinander ab. Geh zurück und korrigiere den Text."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα είδη και το σύνολο διαφέρουν κατά %@. Επιστρέψτε και διορθώστε το κείμενο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los artículos y el total difieren en %@. Vuelve atrás y corrige el texto."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اقلام و مبلغ کل %@ اختلاف دارند. برگردید و متن را اصلاح کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuotteiden summan ja loppusumman erotus on %@. Palaa takaisin ja korjaa teksti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nag-iiba nang %@ ang mga item at kabuuan. Bumalik at itama ang teksto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les articles et le total présentent un écart de %@. Revenez en arrière et corrigez le texte."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá difear %@ idir na hearraí agus an t-iomlán. Téigh ar ais agus ceartaigh an téacs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש הפרש של %@ בין הפריטים לסכום הכולל. חזור ותקן את הטקסט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आइटम और कुल योग में %@ का अंतर है। वापस जाकर टेक्स्ट ठीक करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavke i ukupan iznos razlikuju se za %@. Vrati se i ispravi tekst."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tételek és a végösszeg között %@ az eltérés. Menj vissza, és javítsd ki a szöveget."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ապրանքների և ընդհանուր գումարի միջև տարբերությունը %@ է: Վերադարձեք և ուղղեք տեքստը:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item dan total berbeda sebesar %@. Kembali dan perbaiki teks."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Liðir og heildarupphæð eru mismunandi um %@. Farðu til baka og lagaðu textann."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Articoli e totale differiscono di %@. Torna indietro e correggi il testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目の合計とレシートの合計が%@異なります。戻ってテキストを修正してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목과 합계가 %@만큼 다릅니다. 돌아가서 텍스트를 수정하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekių ir galutinė suma skiriasi %@. Grįžkite ir pataisykite tekstą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Preču un kopējā summa atšķiras par %@. Atgriezieties un izlabojiet tekstu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Item dan jumlah keseluruhan berbeza sebanyak %@. Kembali dan betulkan teks."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ပစ္စည်းများနှင့် စုစုပေါင်းငွေသည် %@ ကွာခြားသည်။ ပြန်သွားပြီး စာသားကိုပြင်ဆင်ပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varene og totalsummen avviker med %@. Gå tilbake og rett teksten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De artikelen en het totaal verschillen %@. Ga terug en corrigeer de tekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozycje i suma różnią się o %@. Wróć i popraw tekst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens e o total diferem em %@. Volte e corrija o texto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Articolele și totalul diferă cu %@. Revino și corectează textul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сумма позиций и итог отличаются на %@. Вернитесь и исправьте текст."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky a celková suma sa líšia o %@. Vráťte sa a opravte text."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Artikujt dhe totali ndryshojnë për %@. Kthehu prapa dhe korrigjo tekstin."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavke i ukupan iznos razlikuju se za %@. Vrati se i ispravi tekst."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varorna och totalsumman skiljer sig med %@. Gå tillbaka och korrigera texten."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vipengee na jumla kuu zinatofautiana kwa %@. Rudi nyuma na usahihishe maandishi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการและยอดรวมต่างกัน %@ กลับไปแก้ไขข้อความ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalemlerle toplam arasında %@ fark var. Geri dönüp metni düzeltin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позиції та загальна сума відрізняються на %@. Поверніться і виправте текст."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mặt hàng và tổng cộng chênh lệch %@. Quay lại và sửa văn bản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目合计与总金额相差%@。请返回并修正文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "項目合計與總金額相差%@。請返回並修正文字。"
          }
        }
      }
    },
