    "Some photos may overlap. Check the receipt lines before confirming.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تتداخل بعض الصور. راجع سطور الإيصال قبل التأكيد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু ছবির অংশ একে অন্যের সঙ্গে মিলে যেতে পারে। নিশ্চিত করার আগে রসিদের লাইনগুলো যাচাই করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neke fotografije se možda preklapaju. Prije potvrde provjerite stavke računa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Některé fotky se mohou překrývat. Před potvrzením zkontrolujte řádky účtenky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle fotos kan overlappe. Kontrollér linjerne på kvitteringen, før du bekræfter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Fotos könnten sich überlappen. Prüfe die Belegzeilen vor dem Bestätigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορισμένες φωτογραφίες μπορεί να επικαλύπτονται. Ελέγξτε τις γραμμές της απόδειξης πριν από την επιβεβαίωση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some photos may overlap. Check the receipt lines before confirming."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que algunas fotos se solapen. Revisa las líneas del recibo antes de confirmar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ممکن است بعضی عکس‌ها هم‌پوشانی داشته باشند. پیش از تأیید، سطرهای رسید را بررسی کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotkin kuvat saattavat olla päällekkäisiä. Tarkista kuitin rivit ennen vahvistamista."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaaring may magkapatong na bahagi sa ilang larawan. Suriin ang mga linya ng resibo bago kumpirmahin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines photos peuvent se chevaucher. Vérifiez les lignes du reçu avant de confirmer."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Seans go bhfuil cuid de na grianghraif ag forluí. Seiceáil línte na hadmhála sula ndeimhníonn tú."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שיש חפיפה בין חלק מהתמונות. בדקו את שורות הקבלה לפני האישור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ फ़ोटो के हिस्से एक-दूसरे से मिल सकते हैं। पुष्टि करने से पहले रसीद की पंक्तियाँ जाँचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neke se fotografije možda preklapaju. Prije potvrde provjerite stavke računa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előfordulhat, hogy egyes fotók átfedik egymást. A jóváhagyás előtt ellenőrizd a nyugta sorait."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Որոշ լուսանկարներ կարող են համընկնող հատվածներ ունենալ։ Հաստատելուց առաջ ստուգեք կտրոնի տողերը։"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa foto mungkin tumpang tindih. Periksa baris pada struk sebelum mengonfirmasi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumar myndir gætu skarast. Athugaðu línurnar á kvittuninni áður en þú staðfestir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune foto potrebbero sovrapporsi. Controlla le righe dello scontrino prima di confermare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の写真が重複している可能性があります。確定する前にレシートの各行を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 사진의 내용이 겹칠 수 있습니다. 확인하기 전에 영수증의 각 줄을 검토하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kai kurios nuotraukos gali persidengti. Prieš patvirtindami patikrinkite kvito eilutes."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Daži fotoattēli var pārklāties. Pirms apstiprināšanas pārbaudiet čeka rindas."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesetengah foto mungkin bertindih. Semak baris pada resit sebelum mengesahkan."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဓာတ်ပုံအချို့တွင် ထပ်နေသော အပိုင်းများ ရှိနိုင်ပါသည်။ အတည်မပြုမီ ပြေစာရှိ စာကြောင်းများကို စစ်ဆေးပါ။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen bilder kan overlappe. Sjekk linjene på kvitteringen før du bekrefter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige foto’s kunnen elkaar overlappen. Controleer de regels op de bon voordat je bevestigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre zdjęcia mogą na siebie nachodzić. Sprawdź pozycje paragonu przed potwierdzeniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas fotos podem se sobrepor. Confira as linhas do recibo antes de confirmar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este posibil ca unele fotografii să se suprapună. Verifică rândurile bonului înainte de a confirma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые фотографии могут перекрываться. Перед подтверждением проверьте строки чека."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektoré fotky sa môžu prekrývať. Pred potvrdením skontrolujte riadky účtenky."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Disa fotografi mund të mbivendosen. Kontrolloni rreshtat e kuponit para se të konfirmoni."
