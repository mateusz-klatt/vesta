    "Only an admin can add receipts, and the server must allow the app to send them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للمسؤول فقط إضافة الإيصالات، ويجب أن يسمح الخادم للتطبيق بإرسالها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু প্রশাসক রসিদ যোগ করতে পারেন এবং সার্ভারকে অ্যাপটিকে সেগুলি পাঠানোর অনুমতি দিতে হবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo administrator može dodavati račune, a server mora dozvoliti aplikaciji da ih šalje."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidávat účtenky může pouze správce a server musí aplikaci povolit jejich odesílání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun en administrator kan tilføje kvitteringer, og serveren skal give appen tilladelse til at sende dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein Administrator kann Belege hinzufügen, und der Server muss der App deren Übertragung erlauben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο ένας διαχειριστής μπορεί να προσθέσει αποδείξεις και ο διακομιστής πρέπει να επιτρέπει στην εφαρμογή να τις στέλνει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un administrador puede añadir tickets, y el servidor debe permitir que la app los envíe."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط مدیر می‌تواند رسید اضافه کند و سرور باید به برنامه اجازه ارسال آن‌ها را بدهد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain ylläpitäjä voi lisätä kuitteja, ja palvelimen on sallittava sovelluksen lähettää niitä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Admin lang ang makakapagdagdag ng mga resibo, at dapat payagan ng server ang app na magpadala ng mga ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un administrateur peut ajouter des tickets, et le serveur doit autoriser l’app à les envoyer."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ní féidir ach le riarthóir admhálacha a chur leis, agus caithfidh an freastalaí ligean don aip iad a sheoladh."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק מנהל יכול להוסיף קבלות, והשרת חייב לאפשר לאפליקציה לשלוח אותן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल एडमिन ही रसीदें जोड़ सकता है, और सर्वर को ऐप को उन्हें भेजने की अनुमति देनी होगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo administrator može dodavati račune, a poslužitelj mora dopustiti aplikaciji da ih šalje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak rendszergazda adhat hozzá nyugtákat, és a szervernek engedélyeznie kell, hogy az app elküldje azokat."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Միայն ադմինիստրատորը կարող է ավելացնել անդորրագրեր, և սերվերը պետք է թույլ տա հավելվածին ուղարկել դրանք:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya admin yang dapat menambahkan struk, dan server harus mengizinkan aplikasi mengirimkannya."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðeins stjórnandi getur bætt við kvittunum og þjónninn verður að leyfa forritinu að senda þær."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un amministratore può aggiungere scontrini e il server deve consentire all’app di inviarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシートを追加できるのは管理者のみです。また、サーバーがアプリからの送信を許可する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자만 영수증을 추가할 수 있으며, 서버에서 앱의 영수증 전송을 허용해야 합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvitų pridėti gali tik administratorius, o serveris turi leisti programai juos siųsti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Čekus var pievienot tikai administrators, un serverim jāļauj lietotnei tos sūtīt."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pentadbir boleh menambah resit dan pelayan mesti membenarkan aplikasi menghantarnya."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ပြေစာများကို အက်ဒမင်သာ ထည့်နိုင်ပြီး ဆာဗာက အက်ပ်က ၎င်းတို့ကိုပေးပို့ရန် ခွင့်ပြုရမည်။"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare en administrator kan legge til kvitteringer, og serveren må la appen sende dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen een beheerder kan bonnen toevoegen en de server moet de app toestaan ze te versturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Paragony może dodawać tylko administrator, a serwer musi pozwalać aplikacji na ich wysyłanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente um administrador pode adicionar recibos, e o servidor deve permitir que o app os envie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar un administrator poate adăuga bonuri, iar serverul trebuie să permită aplicației să le trimită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавлять чеки может только администратор, а сервер должен разрешать приложению отправлять их."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Účtenky môže pridávať iba správca a server musí aplikácii povoliť ich odosielanie."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetëm një administrator mund të shtojë fatura dhe serveri duhet të lejojë aplikacionin t’i dërgojë."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo administrator može da dodaje račune, a server mora da dozvoli aplikaciji da ih šalje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast en administratör kan lägga till kvitton, och servern måste tillåta appen att skicka dem."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni msimamizi pekee anayeweza kuongeza risiti, na seva lazima iruhusu programu kuzituma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะผู้ดูแลระบบเท่านั้นที่เพิ่มใบเสร็จได้ และเซิร์ฟเวอร์ต้องอนุญาตให้แอปส่งใบเสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca yönetici fiş ekleyebilir ve sunucunun uygulamanın bunları göndermesine izin vermesi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додавати чеки може лише адміністратор, а сервер має дозволяти застосунку надсилати їх."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ quản trị viên mới có thể thêm hóa đơn và máy chủ phải cho phép ứng dụng gửi chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有管理员可以添加收据，并且服务器必须允许 App 发送收据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有管理員可以新增收據，而且伺服器必須允許 App 傳送收據。"
          }
        }
      }
    },
