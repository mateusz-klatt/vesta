        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo overlap was estimated. Check the receipt lines before confirming."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha estimado el solapamiento entre las fotos. Revisa las líneas del recibo antes de confirmar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "میزان هم‌پوشانی عکس‌ها برآورد شد. پیش از تأیید، سطرهای رسید را بررسی کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvien päällekkäisyys on arvioitu. Tarkista kuitin rivit ennen vahvistamista."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
